@SET_MAKE@

##############################################################################
SHELL = /bin/sh
GIT = git

# the version of this package
PACKAGE_VERSION = @PACKAGE_VERSION@
GIT_DIR = "@top_srcdir@/.git"

# the list of source files
SOURCES = vm.el
SOURCES += vm-avirtual.el
SOURCES += vm-biff.el
SOURCES += vm-crypto.el
SOURCES += vm-delete.el
SOURCES += vm-digest.el
SOURCES += vm-edit.el
SOURCES += vm-epg.el
SOURCES += vm-folder.el
SOURCES += vm-grepmail.el
SOURCES += vm-imap.el
SOURCES += vm-imap-net.el
SOURCES += vm-license.el
SOURCES += vm-macro.el
SOURCES += vm-mark.el
SOURCES += vm-menu.el
SOURCES += vm-message.el
SOURCES += vm-message-history.el
SOURCES += vm-mime.el
SOURCES += vm-smime.el
SOURCES += vm-minibuf.el
SOURCES += vm-misc.el
SOURCES += vm-net.el
SOURCES += vm-motion.el
SOURCES += vm-mouse.el
SOURCES += vm-page.el
SOURCES += vm-org.el
SOURCES += vm-pcrisis.el
SOURCES += vm-postpone.el
SOURCES += vm-pop.el
SOURCES += vm-pop-net.el
SOURCES += vm-ps-print.el
SOURCES += vm-reply.el
SOURCES += vm-dired.el
SOURCES += vm-save.el
SOURCES += vm-search.el
SOURCES += vm-serial.el
SOURCES += vm-sort.el
SOURCES += vm-startup.el
SOURCES += vm-summary.el
SOURCES += vm-summary-faces.el
SOURCES += vm-thread.el
SOURCES += vm-toolbar.el
SOURCES += vm-undo.el
SOURCES += vm-user.el
SOURCES += vm-vars.el
SOURCES += vm-icalendar.el
SOURCES += vm-vcard.el
SOURCES += vm-virtual.el
SOURCES += vm-window.el
SOURCES += vm-w3m.el
SOURCES += vm-version-conf.el

SOURCES += tapestry.el

AUTOLOADS = vm-autoloads.el

OBJECTS = vm-autoloads.elc $(SOURCES:.el=.elc)

# Generated lisp that is never byte-compiled, so it has no .elc to install.
# `vm-custom-make-dependencies' writes vm-cus-load.el with a
# `no-byte-compile: t' local variable, so listing vm-cus-load.elc in OBJECTS
# asked install for a file that can never exist.
LISP_ONLY = vm-cus-load.el

INSTALL_FILES += $(OBJECTS:.elc=.el) $(OBJECTS) $(LISP_ONLY)

# for BSDmake
.SUFFIXES: .el .elc

##############################################################################
# location of required programms
RM   = @RM@
LS   = @LS@
MKDIR = @MKDIR@
RMDIR = @RMDIR@
XARGS = @XARGS@
INSTALL = @INSTALL@
INSTALL_PROGRAM = @INSTALL_PROGRAM@
INSTALL_SCRIPT = @INSTALL_SCRIPT@
INSTALL_DATA = @INSTALL_DATA@

prefix = @prefix@
srcdir = @srcdir@
datarootdir = @datarootdir@
lispdir = @lispdir@
etcdir= @etcdir@
pixmapdir= @pixmapdir@
docdir = @docdir@
infodir = @infodir@

EMACS_PROG = @EMACS_PROG@
EMACS_FLAVOR = @EMACS_FLAVOR@

FLAGS = @FLAGS@

# Quoted: @OTHERDIRS@ is an elisp list -- ("/some/dir") -- which vm-build.el
# reads back out of the environment.  Unquoted, the shell sees the parenthesis
# and every recipe using this dies with "Syntax error: "(" unexpected".  It
# went unnoticed because with no --with-other-dirs the value is the bare word
# "nil", which the shell is happy with.  Issue #495.
EMACS_COMP = OTHERDIRS='@OTHERDIRS@' "$(EMACS_PROG)" $(FLAGS)

.el.elc:
	$(EMACS_COMP) -f batch-byte-compile $<

##############################################################################
all: $(OBJECTS) $(LISP_ONLY)

$(OBJECTS): $(AUTOLOADS)

install: install-pkg

uninstall: uninstall-pkg

##############################################################################
# Create file with version and commit
vm-version-conf.el: Makefile
	echo ";;; Generated file do not commit -*- lexical-binding: t; -*-" > $@.tmp
	echo '(defvar vm-version-config)' >> $@.tmp
	echo '(defvar vm-version-commit-config)' >> $@.tmp
	echo '(setq vm-version-config "$(PACKAGE_VERSION)")' >> $@.tmp
	if [ -d "$(GIT_DIR)" ]; then \
		commit=`$(GIT) --git-dir="$(GIT_DIR)" rev-parse HEAD`; \
		echo '(setq vm-version-commit-config "'"$${commit}"'")' >> $@.tmp ; \
	else \
		echo '(setq vm-version-commit-config "unknown")' >> $@.tmp ; \
	fi
	mv -f $@.tmp $@

#############################################################################
# GNU Emacs's vm-autoloads file
# We use tr -d because Emacs under Cygwin apparently outputs CRLF
# under Windows.  We remove the CRs.
# Solaris 8's tr -d '\r' removes r's so we use '\015' instead.
# the echo command can also emit CRs.
vm-autoloads.el: $(SOURCES:%=@srcdir@/%)
	-$(RM) -f $@
	echo > $@.tmp
	(build_dir="`pwd`"; cd "@srcdir@" && \
	 $(EMACS_COMP) -l autoload \
		-f vm-built-autoloads "@abs_builddir@/$@.tmp" "`pwd`")
	echo "(custom-add-load 'vm 'vm-cus-load)" | tr -d '\015' >> $@.tmp
#	Before the assignments, not after: vm-vars.el is where the four
#	vm-configure- variables are defined, and assigning to them first is an
#	assignment to a free variable.  It went unwarned while u-vm-color.el
#	was in SOURCES, that being the one file sorting before the vm- ones,
#	so compiling it pulled vm-vars in first and the whole-directory lint
#	saw the definitions anyway.
	echo "(require 'vm-vars)" | tr -d '\015' >> $@.tmp
	echo "(setq vm-configure-datadir \"${etcdir}\")" | tr -d '\015' >> $@.tmp
	echo "(setq vm-configure-pixmapdir \"${pixmapdir}\")" | tr -d '\015' >> $@.tmp
	echo "(setq vm-configure-docdir \"${docdir}\")" | tr -d '\015' >> $@.tmp
	echo "(setq vm-configure-infodir \"${infodir}\")" | tr -d '\015' >> $@.tmp
	echo "(provide 'vm-autoloads)" | tr -d '\015' >> $@.tmp
	mv -f $@.tmp $@

vm-cus-load.el: $(SOURCES:%=@srcdir@/%)
	$(EMACS_COMP) -f vm-custom-make-dependencies .

##############################################################################
install-pkg: all $(INSTALL_FILES)
	@mkdir -p -m 0755 $(DESTDIR)$(lispdir)
	@# Files an earlier VM installed that this one does not, which Emacs
	@# would otherwise go on loading in preference to nothing.  `uninstall'
	@# only knows the current SOURCES, so a dropped file has to be named.
	@$(RM) -f $(DESTDIR)$(lispdir)/vm-pine.el $(DESTDIR)$(lispdir)/vm-pine.elc
	@$(RM) -f $(DESTDIR)$(lispdir)/vm-rfaddons.el \
		  $(DESTDIR)$(lispdir)/vm-rfaddons.elc
	@$(RM) -f $(DESTDIR)$(lispdir)/vm-w3.el $(DESTDIR)$(lispdir)/vm-w3.elc
	@for i in $(SOURCES:%=@srcdir@/%) $(INSTALL_FILES) ; do  \
	  echo "Installing $$i in $(DESTDIR)$(lispdir)" ;    \
	  $(INSTALL_DATA) $$i $(DESTDIR)$(lispdir) ;         \
	done
	@echo VM ELISP files successfully installed

# No prerequisites: uninstall needs the names of the files, not the files.
# With `$(INSTALL_FILES)' here, `make uninstall' byte-compiled the whole of
# VM before deleting it.
uninstall-pkg:
	@# Files an earlier VM installed that this one does not, which Emacs
	@# would otherwise go on loading in preference to nothing.  `uninstall'
	@# only knows the current SOURCES, so a dropped file has to be named.
	@$(RM) -f $(DESTDIR)$(lispdir)/vm-pine.el $(DESTDIR)$(lispdir)/vm-pine.elc
	@$(RM) -f $(DESTDIR)$(lispdir)/vm-rfaddons.el \
		  $(DESTDIR)$(lispdir)/vm-rfaddons.elc
	@$(RM) -f $(DESTDIR)$(lispdir)/vm-w3.el $(DESTDIR)$(lispdir)/vm-w3.elc
	@# $(INSTALL_FILES) is every .el and .elc install puts there.  The list
	@# used to carry $(SOURCES:%=@srcdir@/%) as well, which is the same files
	@# named through the source directory: harmlessly duplicated for an
	@# in-tree build, and pointing outside $(lispdir) for any other.
	@for i in $(INSTALL_FILES) ; do  \
	  echo "Uninstalling $$i from $(DESTDIR)$(lispdir)" ; \
	  $(RM) -f $(DESTDIR)$(lispdir)/$$i ;                  \
	done
	@$(RMDIR) $(DESTDIR)$(lispdir)/ 2> /dev/null || true
	@echo VM ELISP files successfully uninstalled


##############################################################################
Makefile: @srcdir@/Makefile.in
	cd @srcdir@/.. && ./config.status

##############################################################################
clean:
	-$(RM) -f vm-version-conf.el *.elc vm-autoloads.el auto-autoloads.el custom-load.el

distclean: clean
	-$(RM) -f Makefile vm-cus-load.el
