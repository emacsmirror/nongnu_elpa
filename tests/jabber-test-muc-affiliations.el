;;; jabber-test-muc-affiliations.el --- Owned MUC snapshots -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'jabber-core)
(require 'jabber-muc)
(require 'jabber-omemo)

(defun jabber-test-muc-aff--connection (user)
  "Return a disposable established connection for USER."
  (let ((jc (make-symbol user)))
    (put jc :name 'jabber-connection)
    (put jc :state :session-established)
    (put jc :state-data
         (jabber-sm--reset
          (list :username user :server "example.org"
                :connection (list 'transport) :session-id "stream")))
    jc))

(defmacro jabber-test-muc-aff--with-room (&rest body)
  "Run BODY with two isolated connections and a room."
  (declare (indent 0) (debug t))
  `(let* ((a (jabber-test-muc-aff--connection "a"))
          (b (jabber-test-muc-aff--connection "b"))
          (room "room@conference.example.org")
          (jabber-connections (list a b))
          (jabber-muc--rooms (make-hash-table :test #'equal))
          (jabber-muc--room-jids (make-hash-table :test #'equal))
          (jabber-muc--nonanonymous-rooms (make-hash-table :test #'equal))
          (jabber-muc--rooms-before-disconnect (make-hash-table :test #'equal))
          (jabber-muc--session-passwords (make-hash-table :test #'equal))
          (jabber-muc-participants nil)
          (jabber-open-info-queries nil)
          (jabber-muc--autojoin-queue nil)
          (jabber-muc--autojoin-pending nil)
          (jabber-muc--autojoin-disco-count nil)
          (jabber-muc--autojoin-timer nil)
          (jabber-presence-chain '(jabber-muc-process-presence))
          (jabber-iq-chain '(jabber-process-iq))
          sent)
     (jabber-muc-add-groupchat room "self-a" a)
     (jabber-muc-add-groupchat room "self-b" b)
     (cl-letf (((symbol-function 'jabber-send-sexp)
                (lambda (jc xml &rest _) (push (cons jc xml) sent))))
       ,@body)))

(defun jabber-test-muc-aff--requests (sent jc)
  "Return affiliation/ID pairs from SENT stanzas on JC."
  (cl-loop for (owner . xml) in sent when (eq owner jc)
           collect (cons (jabber-xml-get-attribute
                          (car (jabber-xml-get-children (jabber-iq-query xml) 'item))
                          'affiliation)
                         (jabber-xml-get-attribute xml 'id))))

(defun jabber-test-muc-aff--reply (jc room requests affiliation jids &optional from)
  "Deliver a native FSM IQ on JC for ROOM from REQUESTS.
AFFILIATION selects the request; JIDS become items.  FROM overrides issuer."
  (fsm-send-sync
   jc `(:stanza
        (iq ((type . "result") (id . ,(cdr (assoc affiliation requests)))
             (from . ,(or from room)))
            (query ((xmlns . ,jabber-muc-xmlns-admin))
                   ,@(mapcar (lambda (jid)
                               `(item ((jid . ,jid) (affiliation . ,affiliation))))
                             jids))))))

(defun jabber-test-muc-aff--recipients (jc room)
  "Collect ROOM recipients using JC's buffer context."
  (let ((jabber-buffer-connection jc))
    (sort (jabber-omemo--muc-participant-jids
           room (cdr (assoc room jabber-muc-participants))) #'string<)))

(defun jabber-test-muc-aff--presence (jc room nick jid &optional unavailable)
  "Dispatch native occupant presence on JC in ROOM for NICK and JID.
UNAVAILABLE removes the occupant."
  (fsm-send-sync
   jc `(:stanza
        (presence ((from . ,(concat room "/" nick))
                   ,@(when unavailable '((type . "unavailable"))))
                  (x ((xmlns . ,jabber-muc-xmlns-user))
                     (item ((jid . ,jid) (role . "participant")
                            (affiliation . "none"))))))))

(ert-deftest jabber-test-muc-aff-two-accounts-native-iq ()
  (jabber-test-muc-aff--with-room
    (jabber-muc--query-affiliations a room)
    (jabber-muc--query-affiliations b room)
    (jabber-test-muc-aff--reply a room (jabber-test-muc-aff--requests sent a)
                                "member" '("alice@example.org"))
    (jabber-test-muc-aff--reply b room (jabber-test-muc-aff--requests sent b)
                                "member" '("bob@example.org"))
    (should (equal (jabber-test-muc-aff--recipients a room) '("alice@example.org")))
    (should (equal (jabber-test-muc-aff--recipients b room) '("bob@example.org")))))

(ert-deftest jabber-test-muc-aff-empty-reduced-and-other-categories ()
  (jabber-test-muc-aff--with-room
    (jabber-muc--query-affiliations a room)
    (let ((first (jabber-test-muc-aff--requests sent a)))
      (jabber-test-muc-aff--reply a room first "member" '("old@example.org" "kept@example.org"))
      (jabber-test-muc-aff--reply a room first "admin" '("admin@example.org")))
    (jabber-muc--query-affiliations a room)
    (jabber-test-muc-aff--reply a room (jabber-test-muc-aff--requests sent a)
                                "member" '("kept@example.org"))
    (should (equal (jabber-test-muc-aff--recipients a room)
                   '("admin@example.org" "kept@example.org")))
    (jabber-muc--query-affiliations a room)
    (jabber-test-muc-aff--reply a room (jabber-test-muc-aff--requests sent a) "member" nil)
    (should (equal (jabber-test-muc-aff--recipients a room) '("admin@example.org")))))

(ert-deftest jabber-test-muc-aff-out-of-order-and-state-copy ()
  (jabber-test-muc-aff--with-room
    (jabber-muc--query-affiliations a room)
    (let ((old (jabber-test-muc-aff--requests sent a))
          (state (fsm-get-state-data a)))
      (jabber-sm--drain-pending a state)
      (should-not (eq state (fsm-get-state-data a)))
      (jabber-test-muc-aff--reply a room old "owner" '("owner@example.org"))
      (should (equal (jabber-test-muc-aff--recipients a room) '("owner@example.org")))
      (jabber-muc--query-affiliations a room)
      (jabber-test-muc-aff--reply a room (jabber-test-muc-aff--requests sent a) "owner" nil)
      (jabber-test-muc-aff--reply a room (jabber-test-muc-aff--requests sent a)
                                  "member" '("new@example.org"))
      (jabber-test-muc-aff--reply a room old "member" '("obsolete@example.org"))
      (should (equal (jabber-test-muc-aff--recipients a room) '("new@example.org"))))))

(ert-deftest jabber-test-muc-aff-foreign-response-keeps-native-request ()
  (jabber-test-muc-aff--with-room
    (jabber-muc--query-affiliations a room)
    (let* ((requests (jabber-test-muc-aff--requests sent a))
           (id (cdr (assoc "member" requests))))
      (jabber-test-muc-aff--reply b room requests "member" '("foreign@example.org"))
      (should (assoc id jabber-open-info-queries))
      (jabber-test-muc-aff--reply a room requests "member" '("foreign@example.org") "evil@example.org")
      (should (assoc id jabber-open-info-queries))
      (should-not (jabber-test-muc-aff--recipients a room))
      (fsm-send-sync a `(:stanza (iq ((type . "result") (from . ,room) (id . ,id))
                                    (query ((xmlns . "wrong-namespace"))))))
      (should (assoc id jabber-open-info-queries))
      (jabber-test-muc-aff--reply a room requests "member" '("valid@example.org"))
      (should-not (assoc id jabber-open-info-queries))
      (should (equal (jabber-test-muc-aff--recipients a room) '("valid@example.org"))))))

(ert-deftest jabber-test-muc-aff-leave-rejoin-late-result ()
  (jabber-test-muc-aff--with-room
    (jabber-muc--query-affiliations a room)
    (let ((old (jabber-test-muc-aff--requests sent a)))
      (jabber-muc-remove-groupchat room a)
      (jabber-test-muc-aff--reply a room old "member" '("retired@example.org"))
      (should-not (jabber-test-muc-aff--recipients a room))
      (jabber-muc-add-groupchat room "successor" a)
      (jabber-muc--query-affiliations a room)
      (jabber-test-muc-aff--reply a room (jabber-test-muc-aff--requests sent a) "member" nil)
      (jabber-test-muc-aff--reply a room old "admin" '("retired@example.org"))
      (should-not (jabber-test-muc-aff--recipients a room)))))

(ert-deftest jabber-test-muc-aff-reconnect-account-and-transport ()
  (dolist (change '((:connection . replacement) (:session-id . "new-stream")
                    (:username . "new-account")))
    (jabber-test-muc-aff--with-room
      (jabber-muc--query-affiliations a room)
      (let ((old (jabber-test-muc-aff--requests sent a)))
        (jabber-test-muc-aff--reply a room old "member" '("old@example.org"))
        (plist-put (fsm-get-state-data a) (car change) (cdr change))
        (should-not (jabber-test-muc-aff--recipients a room))
        (jabber-muc--query-affiliations a room)
        (jabber-test-muc-aff--reply a room (jabber-test-muc-aff--requests sent a) "member" nil)
        (jabber-test-muc-aff--reply a room old "admin" '("old@example.org"))
        (should-not (jabber-test-muc-aff--recipients a room))))))

(ert-deftest jabber-test-muc-aff-current-occupants-and-offline-members ()
  (jabber-test-muc-aff--with-room
    (jabber-test-muc-aff--presence a room "shared" "alice@example.org/a")
    (jabber-test-muc-aff--presence b room "shared" "bob@example.org/b")
    (jabber-muc--query-affiliations a room)
    (jabber-test-muc-aff--reply a room (jabber-test-muc-aff--requests sent a)
                                "member" '("offline@example.org"))
    (should (equal (jabber-test-muc-aff--recipients a room)
                   '("alice@example.org" "offline@example.org")))
    (should (equal (jabber-test-muc-aff--recipients b room) '("bob@example.org")))
    (jabber-test-muc-aff--presence a room "shared" "alice@example.org/a" t)
    (should (equal (jabber-test-muc-aff--recipients a room) '("offline@example.org")))
    (should (equal (jabber-test-muc-aff--recipients b room) '("bob@example.org")))))

(ert-deftest jabber-test-muc-aff-disconnect-reconnect-native-lifecycle ()
  (jabber-test-muc-aff--with-room
    (jabber-muc--query-affiliations a room)
    (jabber-muc--query-affiliations b room)
    (let ((old (jabber-test-muc-aff--requests sent a)))
      (jabber-test-muc-aff--reply b room (jabber-test-muc-aff--requests sent b)
                                  "member" '("bob@example.org"))
      (jabber-muc--session-reset a)
      (should-not (gethash (list a room) jabber-muc--room-jids))
      (jabber-test-muc-aff--reply a room old "member" '("retired@example.org"))
      (should-not (gethash (list a room) jabber-muc--room-jids))
      (should (equal (jabber-test-muc-aff--recipients b room) '("bob@example.org")))
      (plist-put (fsm-get-state-data a) :connection (list 'replacement))
      (plist-put (fsm-get-state-data a) :session-id "successor-stream")
      (jabber-muc-add-groupchat room "successor" a)
      (jabber-muc--query-affiliations a room)
      (jabber-test-muc-aff--reply a room (jabber-test-muc-aff--requests sent a)
                                  "member" '("new@example.org"))
      (jabber-test-muc-aff--reply a room old "admin" '("retired@example.org"))
      (should (equal (jabber-test-muc-aff--recipients a room) '("new@example.org"))))))

(ert-deftest jabber-test-muc-aff-sender-scope-and-revoked-inference ()
  (jabber-test-muc-aff--with-room
    (jabber-test-muc-aff--presence a room "shared" "alice@example.org/a")
    (jabber-test-muc-aff--presence b room "shared" "bob@example.org/b")
    (let ((xml `(message ((from . ,(concat room "/shared")) (type . "groupchat")))))
      (should (equal (jabber-omemo--resolve-sender-jid xml a) "alice@example.org"))
      (should (equal (jabber-omemo--resolve-sender-jid xml b) "bob@example.org"))
      (jabber-muc-remove-groupchat room a)
      (should-not (jabber-omemo--resolve-sender-jid xml a)))
    (jabber-test-muc-aff--presence b room "unknown" nil)
    (jabber-muc--query-affiliations b room)
    (jabber-test-muc-aff--reply b room (jabber-test-muc-aff--requests sent b)
                                "member" '("offline@example.org"))
    (let ((xml `(message ((from . ,(concat room "/unknown")) (type . "groupchat")))))
      (should (equal (jabber-omemo--resolve-sender-jid xml b) "offline@example.org"))
      (jabber-muc--query-affiliations b room)
      (jabber-test-muc-aff--reply b room (jabber-test-muc-aff--requests sent b) "member" nil)
      (should-not (jabber-omemo--resolve-sender-jid xml b)))))

(ert-deftest jabber-test-muc-aff-pending-occupants-survive-self-presence ()
  (jabber-test-muc-aff--with-room
    (jabber-muc-remove-groupchat room a)
    (let ((attempt (jabber-muc--start-attempt a room "self-a")))
      (unwind-protect
          (cl-letf (((symbol-function 'jabber-mam-muc-joined) #'ignore)
                    ((symbol-function 'jabber-bookmarks-auto-add-maybe) #'ignore))
            (jabber-test-muc-aff--presence a room "early" "early@example.org/device")
            (should-not (jabber-test-muc-aff--recipients a room))
            (jabber-test-muc-aff--presence a room "self-a" "a@example.org/device")
            (should (equal (jabber-test-muc-aff--recipients a room)
                           '("a@example.org" "early@example.org"))))
        (when (timerp (plist-get attempt :timer))
          (cancel-timer (plist-get attempt :timer)))))))

(ert-deftest jabber-test-muc-aff-callback-cannot-recreate-or-replay ()
  (jabber-test-muc-aff--with-room
    (jabber-muc--query-affiliations a room)
    (let* ((requests (jabber-test-muc-aff--requests sent a))
           (id (cdr (assoc "member" requests)))
           (callback (nth 1 (assoc id jabber-open-info-queries)))
           (xml `(iq ((from . ,room) (type . "result"))
                     (query ((xmlns . ,jabber-muc-xmlns-admin))
                            (item ((jid . "obsolete@example.org")
                                   (affiliation . "member")))))))
      (jabber-test-muc-aff--reply a room requests "member" nil)
      (funcall (car callback) a xml (cdr callback))
      (should-not (jabber-test-muc-aff--recipients a room))
      (jabber-muc-remove-groupchat room a)
      (funcall (car callback) a xml (cdr callback))
      (should-not (gethash (list a room) jabber-muc--room-jids)))))

(ert-deftest jabber-test-muc-aff-blocking-uses-owned-recipients ()
  (jabber-test-muc-aff--with-room
    (plist-put (fsm-get-state-data a) :blocking-list '("blocked@example.org"))
    (jabber-test-muc-aff--presence a room "shared" "blocked@example.org/device")
    (jabber-test-muc-aff--presence b room "shared" "allowed@example.org/device")
    (should-error (jabber-omemo--check-blocking a room t) :type 'user-error)
    (should-not (jabber-omemo--check-blocking b room t))
    (jabber-test-muc-aff--presence a room "shared" "blocked@example.org/device" t)
    (should-not (jabber-omemo--check-blocking a room t))))

