(ert-deftest jabber-test-muc-aff-inflight-send-rechecks-before-wrapping ()
  (dolist (retire '(nil snapshot membership))
    (jabber-test-muc-aff--with-room
      (jabber-muc--query-affiliations a room)
      (jabber-test-muc-aff--reply a room (jabber-test-muc-aff--requests sent a)
                                  "member" '("peer@example.org"))
      (let ((jabber-group room)
            (jabber-buffer-connection a)
            (jabber-omemo--pending-send-operations (make-hash-table :test #'eq))
            (wrapped 0) (failed 0) continuation)
        (cl-letf (((symbol-function 'jabber-chat--capture-input-owner)
                   (lambda () (lambda () t)))
                  ((symbol-function 'jabber-omemo--ensure-sessions-multi)
                   (lambda (_jc _jids callback) (setq continuation callback)))
                  ((symbol-function 'jabber-omemo--ensure-sessions)
                   (lambda (_jc _jid callback) (funcall callback nil)))
                  ((symbol-function 'jabber-omemo-encrypt-message)
                   (lambda (_) (cl-incf wrapped)
                     '(:iv "iv" :key "key" :payload "payload")))
                  ((symbol-function 'jabber-omemo--build-encrypted-xml)
                   (lambda (&rest _) '(encrypted nil))))
          (jabber-omemo--send-muc
           a "correction" '((replace ((id . "original")))) nil
           (lambda (_reason) (cl-incf failed)))
          (pcase retire
            ('snapshot
             (jabber-muc--query-affiliations a room)
             (jabber-test-muc-aff--reply a room (jabber-test-muc-aff--requests sent a)
                                         "member" nil))
            ('membership
             (jabber-muc-remove-groupchat room a)
             (jabber-muc-add-groupchat room "successor" a)
             (jabber-muc--query-affiliations a room)
             (jabber-test-muc-aff--reply a room (jabber-test-muc-aff--requests sent a)
                                         "member" '("peer@example.org"))))
          (funcall continuation '((7 "a@example.org" "peer@example.org" session)))
          (should (= wrapped (if retire 0 1)))
          (should (= failed (if retire 1 0))))))))

(defun jabber-test-muc-aff--resume (jc)
  "Deliver a successful native SM resume on a replacement transport for JC."
  (let ((jabber-post-resume-hooks nil))
    (plist-put (fsm-get-state-data jc) :sm-enabled t)
    (plist-put (fsm-get-state-data jc) :sm-id "resume-id")
    (plist-put (fsm-get-state-data jc) :sm-resuming t)
    (plist-put (fsm-get-state-data jc) :connection (list 'resumed-transport))
    ;; A real resumed connection receives a new stream header before <resumed>.
    (put jc :state :connected)
    (let ((jabber-use-sasl t))
      (fsm-send-sync jc '(:stream-start "replacement-stream" "1.0")))
    (should (equal (plist-get (fsm-get-state-data jc) :session-id) "replacement-stream"))
    (put jc :state :sm-resume)
    (cl-letf (((symbol-function 'jabber-sm--start-r-timer) (lambda (_jc data) data))
              ((symbol-function 'jabber-sm--schedule-drain) #'ignore))
      (fsm-send-sync jc '(:stanza (resumed ((xmlns . "urn:xmpp:sm:3")
                                           (h . "0") (previd . "resume-id"))))))
    (should (eq (get jc :state) :session-established))))

(defun jabber-test-muc-aff--sender (jc room nick)
  "Resolve NICK's native encrypted sender identity in ROOM on JC."
  (jabber-omemo--resolve-sender-jid
   `(message ((from . ,(concat room "/" nick)) (type . "groupchat"))) jc))

(ert-deftest jabber-test-muc-aff-resume-ready-identities ()
  "Resume retains current identities, not old query or membership authority."
  (jabber-test-muc-aff--with-room
    (jabber-muc--start-attempt a room "self-a")
    (jabber-test-muc-aff--presence a room "self-a" nil)
    (jabber-test-muc-aff--presence a room "online" "online@example.org/device")
    (jabber-test-muc-aff--presence b room "online" "other@example.org/device")
    (jabber-muc--query-affiliations a room)
    (jabber-muc--query-affiliations b room)
    (let ((old (jabber-test-muc-aff--requests sent a))
          (other (jabber-test-muc-aff--requests sent b))
          (membership (assq a (jabber-muc-room-entries room)))
          (record (jabber-muc--identity-record a room)))
      (jabber-test-muc-aff--reply a room old "member" '("offline@example.org"))
      (jabber-test-muc-aff--resume a)
      (should (eq membership (assq a (jabber-muc-room-entries room))))
      (should (jabber-sm--room-ready-p (fsm-get-state-data a) room))
      (should (equal (jabber-test-muc-aff--recipients a room)
                     '("offline@example.org" "online@example.org")))
      (should (equal (jabber-test-muc-aff--sender a room "online") "online@example.org"))
      (should-not (eq record (jabber-muc--identity-record a room)))
      (jabber-test-muc-aff--presence a room "new" "new@example.org/device")
      (jabber-test-muc-aff--reply a room old "admin" '("stale@example.org"))
      (should (equal (jabber-test-muc-aff--recipients a room)
                     '("new@example.org" "offline@example.org" "online@example.org")))
      ;; Another account's still-current query and occupant survive the transfer.
      (jabber-test-muc-aff--reply b room other "member" '("other-offline@example.org"))
      (should (equal (jabber-test-muc-aff--recipients b room)
                     '("other-offline@example.org" "other@example.org")))
      (jabber-muc--query-affiliations a room)
      (jabber-test-muc-aff--reply a room (jabber-test-muc-aff--requests sent a) "member" nil)
      (jabber-test-muc-aff--presence a room "online" "online@example.org/device" t)
      (jabber-test-muc-aff--presence a room "new" "new@example.org/device" t)
      (should-not (jabber-test-muc-aff--recipients a room))
      (should-not (jabber-test-muc-aff--sender a room "online"))
      (jabber-muc-remove-groupchat room a)
      (jabber-muc-add-groupchat room "successor" a)
      (jabber-test-muc-aff--reply a room old "owner" '("stale@example.org"))
      (should-not (jabber-test-muc-aff--recipients a room)))))

(ert-deftest jabber-test-muc-aff-resume-pending-identities ()
  "A pending join transfers early occupants but cannot send until confirmed."
  (jabber-test-muc-aff--with-room
    (jabber-muc-remove-groupchat room a)
    (jabber-muc--start-attempt a room "self-a")
    (unwind-protect
        (cl-letf (((symbol-function 'jabber-mam-muc-joined) #'ignore)
                  ((symbol-function 'jabber-bookmarks-auto-add-maybe) #'ignore))
          (jabber-test-muc-aff--presence a room "early" "early@example.org/device")
          (let ((old (jabber-sm--room-attempt (fsm-get-state-data a) room)))
            (jabber-test-muc-aff--resume a)
            (should-not (jabber-muc--attempt-current-p a room old t))
            (should-not (jabber-test-muc-aff--recipients a room))
            (jabber-test-muc-aff--presence a room "later" "later@example.org/device")
            (jabber-test-muc-aff--presence a room "self-a" nil)
            (should (equal (jabber-test-muc-aff--recipients a room)
                           '("early@example.org" "later@example.org")))
            (should (equal (jabber-test-muc-aff--sender a room "early") "early@example.org"))
            (jabber-test-muc-aff--presence a room "early" "early@example.org/device" t)
            (jabber-test-muc-aff--presence a room "later" "later@example.org/device" t)
            (should-not (jabber-test-muc-aff--recipients a room))))
      (let ((timer (plist-get (jabber-sm--room-attempt (fsm-get-state-data a) room) :timer)))
        (when (timerp timer) (cancel-timer timer))))))

(ert-deftest jabber-test-muc-aff-resume-rejects-retired-owners ()
  "Resume cannot bless another account, session, transport or room lifetime."
  (dolist (change '(account session transport membership))
    (jabber-test-muc-aff--with-room
      (jabber-muc--start-attempt a room "self-a")
      (jabber-test-muc-aff--presence a room "self-a" nil)
      (jabber-test-muc-aff--presence a room "old" "old@example.org/device")
      (jabber-muc--query-affiliations a room)
      (let ((old (jabber-test-muc-aff--requests sent a)))
        (jabber-test-muc-aff--reply a room old "member" '("offline@example.org"))
        (pcase change
          ('account (plist-put (fsm-get-state-data a) :username "replacement"))
          ('session (plist-put (jabber-muc--identity-record a room) :session "unowned"))
          ('transport (plist-put (jabber-muc--identity-record a room) :transport 'unowned))
          ('membership
           (jabber-muc-remove-groupchat room a)
           (jabber-muc-add-groupchat room "replacement" a)))
        (jabber-test-muc-aff--resume a)
        (jabber-test-muc-aff--reply a room old "admin" '("stale@example.org"))
        (should-not (jabber-test-muc-aff--recipients a room))
        (should-not (jabber-test-muc-aff--sender a room "old"))))))

(ert-deftest jabber-test-muc-aff-failed-resume-retires-identities ()
  "The native failed-resume fresh-bind path retires the old identity view."
  (jabber-test-muc-aff--with-room
    (let ((jabber-lifecycle-session-reset-functions '(jabber-muc--session-reset)))
      (jabber-muc--start-attempt a room "self-a")
      (jabber-test-muc-aff--presence a room "self-a" nil)
      (jabber-test-muc-aff--presence a room "old" "old@example.org/device")
      (jabber-test-muc-aff--presence b room "old" "other@example.org/device")
      (jabber-muc--query-affiliations a room)
      (let ((old (jabber-test-muc-aff--requests sent a)))
        (jabber-test-muc-aff--reply a room old "member" '("offline@example.org"))
        (put a :state :sm-resume)
        (plist-put (fsm-get-state-data a) :stream-features
                   '(features () (bind ((xmlns . "urn:ietf:params:xml:ns:xmpp-bind")))))
        (cl-letf (((symbol-function 'jabber--send-bind-request) #'ignore))
          (fsm-send-sync a '(:stanza (failed ((xmlns . "urn:xmpp:sm:3"))))))
        (should-not (gethash (list a room) jabber-muc--room-jids))
        (should-not (jabber-test-muc-aff--recipients a room))
        (should (equal (jabber-test-muc-aff--recipients b room) '("other@example.org")))
        (put a :state :session-established)
        (jabber-muc-add-groupchat room "successor" a)
        (jabber-test-muc-aff--reply a room old "admin" '("stale@example.org"))
        (should-not (jabber-test-muc-aff--recipients a room))))))

(ert-deftest jabber-test-muc-aff-concurrent-native-nick-retirement ()
  "Foreign 303 and self confirmation retire aliases without settling our lease."
  (let ((send (symbol-function 'jabber-send-sexp)))
    (dolist (pending '(nil t resume))
      (jabber-test-muc-aff--with-room
        (jabber-muc--start-attempt a room "self-a")
        (jabber-test-muc-aff--presence a room "self-a" "a@example.org/device")
        (jabber-test-muc-aff--presence a room "guest" "guest@example.org/device")
        (jabber-test-muc-aff--presence b room "guest" "other@example.org/device")
        (when pending
          (cl-letf (((symbol-function 'jabber-send-sexp) send)
                    ((symbol-function 'jabber-send-sexp--raw) (lambda (&rest _) t)))
            (jabber-muc-nick a room "new-self")))
        (when (eq pending 'resume) (jabber-test-muc-aff--resume a))
        (let ((attempt (jabber-sm--room-attempt (fsm-get-state-data a) room)))
          (unwind-protect
              (progn
                (fsm-send-sync
                 a `(:stanza (presence ((from . ,(concat room "/guest")) (type . "unavailable"))
                                       (x ((xmlns . ,jabber-muc-xmlns-user))
                                          (item ((nick . "guest-new") (affiliation . "none")))
                                          (status ((code . "303")))))))
                (should (eq attempt (jabber-sm--room-attempt (fsm-get-state-data a) room)))
                (should (eq (plist-get attempt :status) (if pending 'pending 'ready)))
                (should-not (jabber-test-muc-aff--sender a room "guest"))
                (jabber-test-muc-aff--presence a room "guest-new" "guest@example.org/device")
                (should (equal (jabber-test-muc-aff--sender a room "guest-new") "guest@example.org"))
                (jabber-test-muc-aff--presence a room "guest-new" "guest@example.org/device" t)
                (when pending
                  ;; Some servers confirm without a preceding self 303.
                  (jabber-test-muc-aff--presence a room "new-self" "a@example.org/device")
                  (should-not (jabber-test-muc-aff--sender a room "self-a"))
                  (should (equal (jabber-test-muc-aff--sender a room "new-self") "a@example.org")))
                (should (jabber-sm--room-ready-p (fsm-get-state-data a) room))
                (should-not (jabber-test-muc-aff--sender a room "guest-new"))
                (should (equal (jabber-test-muc-aff--recipients a room) '("a@example.org")))
                (should (equal (jabber-test-muc-aff--recipients b room) '("other@example.org")))
                (should (equal (jabber-test-muc-aff--sender b room "guest") "other@example.org")))
            (when (timerp (plist-get attempt :timer))
              (cancel-timer (plist-get attempt :timer)))))))))

(ert-deftest jabber-test-muc-aff-native-self-303-retires-only-alias ()
  "Self 303 retires its alias, never the lease or another account's occupant."
  (let ((send (symbol-function 'jabber-send-sexp)))
    (dolist (self-status '(nil t))
      (jabber-test-muc-aff--with-room
        (jabber-muc--start-attempt a room "self-a")
        (jabber-test-muc-aff--presence a room "self-a" "a@example.org/device")
        (jabber-test-muc-aff--presence b room "self-a" "other@example.org/device")
        (cl-letf (((symbol-function 'jabber-send-sexp) send)
                  ((symbol-function 'jabber-send-sexp--raw) (lambda (&rest _) t)))
          (jabber-muc-nick a room "new-self"))
        (let ((attempt (jabber-sm--room-attempt (fsm-get-state-data a) room))
              (membership (assq a (jabber-muc-room-entries room))))
          (unwind-protect
              (progn
                (fsm-send-sync
                 a `(:stanza (presence ((from . ,(concat room "/self-a")) (type . "unavailable"))
                                       (x ((xmlns . ,jabber-muc-xmlns-user))
                                          (item ((nick . "new-self")))
                                          ,@(when self-status '((status ((code . "110")))))
                                          (status ((code . "303")))))))
                (should (eq attempt (jabber-sm--room-attempt (fsm-get-state-data a) room)))
                (should (eq membership (assq a (jabber-muc-room-entries room))))
                (should (eq (plist-get attempt :status) 'pending))
                (should-not (jabber-test-muc-aff--sender a room "self-a"))
                (jabber-test-muc-aff--presence a room "new-self" "a@example.org/device")
                (should (jabber-sm--room-ready-p (fsm-get-state-data a) room))
                (should (equal (jabber-test-muc-aff--sender a room "new-self") "a@example.org"))
                (should (equal (jabber-test-muc-aff--sender b room "self-a") "other@example.org")))
            (when (timerp (plist-get attempt :timer))
              (cancel-timer (plist-get attempt :timer)))))))))

