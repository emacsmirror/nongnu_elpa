(ert-deftest hermes-groups-follow-native-lease-survives-second-read ()
  ;; Restore both native lease functions inside the wire fixture.  Only startup
  ;; and socket writes are controlled; no hand-assigned reference counts.
  (let ((acquire (symbol-function 'hermes-dashboard-transport-acquire))
        (release (symbol-function 'hermes-dashboard-transport-release)))
    (dolist (shared '(nil t))
      (dolist (retirement '(off kill mode file backend stop reconnect terminal expired))
        (hermes-groups-test--wire
          (let ((hermes-dashboard-transport--clients (make-hash-table :test #'equal))
                (hermes-dashboard-transport-idle-close-delay nil)
                (schedule (symbol-function 'run-at-time)) callback owned-timer chat retained-cleanup)
            (cl-letf (((symbol-function 'hermes-dashboard-transport-acquire) acquire)
                      ((symbol-function 'hermes-dashboard-transport-release) release)
                      ((symbol-function 'hermes-dashboard-transport-start) (lambda (&rest _) client))
                      ((symbol-function 'hermes-dashboard-transport--reconnect-attempt) #'ignore)
                      ((symbol-function 'hermes-browser--existing-client) (lambda () chat))
                      ((symbol-function 'run-at-time)
                       (lambda (time repeat fn &rest args)
                         (let ((timer (apply schedule time repeat fn args)))
                           (when (eql time 5) (setq callback fn owned-timer timer))
                           timer))))
              (when shared
                (let ((hermes-dashboard-transport-url (cdr instance)))
                  (setq chat (hermes-dashboard-transport-acquire))))
              (with-current-buffer (view)
                (hermes-groups-follow) (state)
                (answer "groups.log" (hermes-groups-test--page nil 0 0))
                (should hermes-groups--follow)
                (should (memq owned-timer timer-list))
                (should (= (hermes-dashboard-transport-client-refcount client) (if shared 2 1)))
                ;; Advance the owned native timer, then yield to its real
                ;; delivery rather than invoking the continuation ourselves.
                (cancel-timer owned-timer)
                (timer-set-time owned-timer (current-time))
                (timer-activate owned-timer)
                (hermes-test--wait-until (lambda () frames) 2 "second Follow read")
                (should-not (memq owned-timer timer-list))
                (state)
                (answer "groups.log" (hermes-groups-test--page (list (hermes-groups-test--event 1)) 1 1))
                (should (= hermes-groups--cursor 1))
                (should hermes-groups--follow)
                (should (= (hermes-dashboard-transport-client-refcount client) (if shared 2 1)))
                (setq retained-cleanup hermes-groups--follow-cleanup)
                (pcase retirement
                  ('off (hermes-groups-follow))
                  ('kill (kill-buffer (current-buffer)))
                  ('mode (fundamental-mode))
                  ('file (set-visited-file-name (expand-file-name "notes" temporary-file-directory) t))
                  ('backend (hermes-browser--own-instance (cons "other" "http://other.invalid")))
                  ('stop (hermes-dashboard-transport-stop client))
                  ('reconnect (hermes-dashboard-transport-reconnect client))
                  ('expired (funcall callback)
                            (answer "groups.capabilities" hermes-groups-test--capabilities)
                            (answer "groups.state"
                                    '((code . 4114) (data . ((reason . "room_history_expired")))) t))
                  ('terminal (funcall callback) (state 1 t)
                             (answer "groups.log" (hermes-groups-test--page nil 1 1))))
                (should-not (memq owned-timer timer-list))
                (funcall callback)
                (funcall retained-cleanup)
                (funcall retained-cleanup)
                (should-not frames)
                (should (= (hermes-dashboard-transport-client-refcount client)
                           (if (and shared (not (eq retirement 'stop))) 1 0)))
                (should (zerop (hash-table-count (hermes-dashboard-transport-client-pending client)))))
              (when chat (hermes-dashboard-transport-release chat)))))))))

(ert-deftest hermes-groups-native-hook-successor-survives-unwind ()
  (dolist (hook '(before-change-functions after-change-functions))
    (dolist (transfer '(file generation mode))
      (dolist (fault '(error quit))
        (hermes-groups-test--wire
          (with-current-buffer (view)
            (hermes-groups-refresh) (state)
            (answer "groups.log" (hermes-groups-test--page (list (hermes-groups-test--event 1)) 1 1))
            (hermes-groups-refresh) (state)
            (let ((fn (lambda (&rest _)
                        (pcase transfer
                          ('file (set-visited-file-name (expand-file-name "notes" temporary-file-directory) t))
                          ('generation (hermes-browser--next-request-generation))
                          ('mode (fundamental-mode)))
                        (let ((inhibit-modification-hooks t) (inhibit-read-only t))
                          (erase-buffer) (insert "successor's unsaved draft"))
                        (buffer-enable-undo)
                        (setq buffer-undo-list nil)
                        (signal fault '("successor hook")))))
              (add-hook hook fn nil t)
              (answer "groups.log" (hermes-groups-test--page (list (hermes-groups-test--event 2)) 2 3))
              (remove-hook hook fn t))
            (should (equal (buffer-string) "successor's unsaved draft"))
            (should (listp buffer-undo-list))
            (should-not frames)
            (should-not hermes-browser--owned-cleanup)
            (unless (eq transfer 'mode) (should (= hermes-groups--cursor 1)))))))))

