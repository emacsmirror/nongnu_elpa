          (alist-get 'task_id (alist-get 'payload event)) task)
    (when generation
      (setf (alist-get 'execution_generation (alist-get 'payload event)) generation))
    event))

(ert-deftest hermes-groups-participation-historical-tasks-do-not-veto-fresh-approval ()
  ;; Fresh and reopened views need no local Stop memory.  Terminal counts are
  ;; retained history; backend terminal task IDs, not those counts, retire rows.
  (dolist (kind '("turn.cancelled" "turn.failed" "turn.settled"))
    (dolist (reopen '(nil t))
      (hermes-groups-test--wire
        (when reopen (kill-buffer (view)))
        (with-current-buffer (view)
          (let* ((driver (hermes-groups-test--pending))
                 (old (car (alist-get 'pending_actions driver)))
                 (fresh (copy-tree old))
                 (event (hermes-groups-test--terminal 1 kind "task"))
                 (room (hermes-groups-test--empty-room 2))
                 (state `((room . ,room) (driver_status . ,driver)))
                 offered
                 (completing-read-function
                  (lambda (_ choices &rest _)
                    (if (stringp (car choices)) "deny"
                      (setq offered (mapcar #'cdr choices)) (caar choices)))))
            (setf (alist-get 'task_id fresh) "fresh"
                  (alist-get 'request_id fresh) "fresh-request"
                  (alist-get 'pending_actions driver) (list old fresh)
                  (alist-get 'counts driver) `((settled . ,(if reopen 0 1)) (running . 1)))
            (setq hermes-groups--room room)
            (call-interactively (key-binding (kbd "a")))
            (answer "groups.capabilities" (hermes-groups-test--write-caps))
            (answer "groups.state" state)
            (should (= 0 (alist-get 'since_seq (alist-get 'params (car frames)))))
            (answer "groups.log" (hermes-groups-test--page (list event) 1 2))
            (should-not offered)
            (should (= 1 (alist-get 'since_seq (alist-get 'params (car frames)))))
            (answer "groups.log" (hermes-groups-test--page (list (hermes-groups-test--event 2 "message.user")) 2 2))
            (should (equal (mapcar (lambda (row) (alist-get 'task_id row)) offered) '("fresh")))
            (answer "groups.state" state)
            (should (= 2 (alist-get 'since_seq (alist-get 'params (car frames)))))
            (answer "groups.log" (hermes-groups-test--page nil 2 2))
            (should (equal (alist-get 'method (car frames)) "groups.approve"))
            (should (equal (alist-get 'params (car frames))
                           '((room_id . "room") (member_id . "a") (task_id . "fresh")
                             (execution_generation . 3) (request_id . "fresh-request") (choice . "deny"))))))))))

(ert-deftest hermes-groups-participation-approval-incomplete-evidence-refuses ()
  (dolist (fault '(room epoch cursor task member actor short partial old-epoch stopping unpublished))
    (hermes-groups-test--wire
      (with-current-buffer (view)
        (let* ((room (hermes-groups-test--empty-room 1))
               (driver (hermes-groups-test--pending))
               (event (hermes-groups-test--terminal 1 "turn.failed" "old-task"))
               (page (hermes-groups-test--page (list event) 1 1))
               (readers 0)
               (completing-read-function (lambda (&rest _) (cl-incf readers) "deny")))
          (pcase fault
            ('room (setf (alist-get 'room_id event) "other"))
            ('epoch (setf (alist-get 'epoch (alist-get 'authority page)) 2))
            ('cursor (setf (alist-get 'cursor page) 0))
            ('task (setf (alist-get 'task_id (alist-get 'payload event)) nil))
            ('member (setf (alist-get 'member_id (alist-get 'payload event)) nil))
            ('actor (setf (alist-get 'kind (alist-get 'actor event)) "member"))
            ('short (setf (alist-get 'latest_seq room) 2))
            ('unpublished (setf (alist-get 'counts driver) '((cancelled . 2) (running . 1))))
            ('old-epoch (setf (alist-get 'authority_epoch event) nil))
            ('stopping (setf (alist-get 'counts driver) '((running . 1) (stopping . 1)))))
          (setq hermes-groups--room room)
          (hermes-groups-approve)
          (answer "groups.capabilities" (hermes-groups-test--write-caps))
          (answer "groups.state" `((room . ,room) (driver_status . ,driver)))
          (if (eq fault 'partial)
              (dotimes (n 20)
                (answer "groups.log" (hermes-groups-test--page
                                      (list (hermes-groups-test--event (1+ n) "message.user")) (1+ n) 21)))
            (answer "groups.log" page)
            ;; Native log validation permits one state reconciliation, not a skip.
            (when frames
              (answer "groups.state" `((room . ,room) (driver_status . ,driver)))
              (answer "groups.log" page)))
          (should (= readers 0))
          (should-not (member "groups.approve" all-methods))
          (should-not frames)
          (should-not hermes-groups--mutation))))))

(ert-deftest hermes-groups-participation-deferred-generation-and-retry-authority ()
  (dolist (case '(old fresh retry))
    (hermes-groups-test--wire
      (with-current-buffer (view)
        (let* ((room (hermes-groups-test--empty-room 1))
               (driver (hermes-groups-test--pending))
               (event (hermes-groups-test--terminal 1 "turn.deferred" "task" 3))
               (state `((room . ,room) (driver_status . ,driver)))
               (completing-read-function
                (lambda (_ choices &rest _) (if (stringp (car choices)) "deny" (caar choices)))))
          (pcase case
            ('fresh (setf (alist-get 'execution_generation (car (alist-get 'pending_actions driver))) 4))
            ('retry (setf (alist-get 'pending_actions driver)
                          (append (alist-get 'pending_actions driver) '(((kind . "retry") (task_id . "task")))))))
          (setq hermes-groups--room room)
          (hermes-groups-approve)
          (answer "groups.capabilities" (hermes-groups-test--write-caps))
          (answer "groups.state" state)
          (answer "groups.log" (hermes-groups-test--page (list event) 1 1))
          (if (eq case 'fresh)
              (progn
                (answer "groups.state" state)
                (answer "groups.log" (hermes-groups-test--page nil 1 1))
                (should (= 4 (alist-get 'execution_generation (alist-get 'params (car frames))))))
            (should-not frames)
            (should-not (member "groups.approve" all-methods))))))))

(ert-deftest hermes-groups-participation-deferred-retry-consent-and-retirement ()
  (dolist (fault '(nil cancel consent state readiness reconnect))
    (hermes-groups-test--wire
      (with-current-buffer (view)
        (let* ((room (hermes-groups-test--empty-room))
               (driver '((working . :false) (counts . ((deferred . 1)))
                         (pending_actions . (((kind . "retry") (task_id . "exact-uncertain-task"))))))
               (state `((room . ,room) (driver_status . ,driver)))
               prompt
               (completing-read-function (lambda (_ choices &rest _) (caar choices))))
          (setq hermes-groups--room room)
          (cl-letf (((symbol-function 'yes-or-no-p)
                     (lambda (text)
                       (setq prompt text)
                       (when (eq fault 'consent) (setq hermes-instance '("other" . "http://other.invalid")))
                       (not (eq fault 'cancel)))))
            (call-interactively (key-binding (kbd "r")))
            (answer "groups.capabilities" (hermes-groups-test--write-caps))
            (answer "groups.state" state)
            (should (string-match-p "exact-uncertain-task.*Prior execution is uncertain.*effects" prompt))
            (unless (memq fault '(cancel consent))
              (when (memq fault '(readiness reconnect))
                (setf (hermes-dashboard-transport-client-ready-p client) nil
                      (hermes-dashboard-transport-client-ready-promise client) (hermes--promise-make)))
              (answer "groups.state" (if (eq fault 'state) `((room . ,room) (driver_status . ((pending_actions)))) state))
              (when (memq fault '(readiness reconnect))
                (let ((ready (hermes-dashboard-transport-client-ready-promise client)))
                  (if (eq fault 'reconnect) (hermes-dashboard-transport-stop client)
                    (setq hermes-instance '("other" . "http://other.invalid")))
                  (setf (hermes-dashboard-transport-client-ready-p client) t)
                  (hermes--promise-resolve ready client))))
            (if fault
                (progn (should-not frames) (should-not (member "groups.retry" all-methods)))
              (should (equal (alist-get 'method (car frames)) "groups.retry"))
              (should (equal (alist-get 'params (car frames)) '((room_id . "room") (task_id . "exact-uncertain-task")))))))))))

(ert-deftest hermes-groups-participation-approval-late-log-and-readiness-retirement ()
  (dolist (fault '(nil terminal request cursor epoch roster file readiness))
    (hermes-groups-test--wire
      (with-current-buffer (view)
        (let* ((room (hermes-groups-test--empty-room))
               (driver (hermes-groups-test--pending))
               (state `((room . ,room) (driver_status . ,driver)))
               (completing-read-function
                (lambda (_ choices &rest _) (if (stringp (car choices)) "deny" (caar choices)))))
          (setq hermes-groups--room room)
          (hermes-groups-approve)
          (answer "groups.capabilities" (hermes-groups-test--write-caps))
          (answer "groups.state" state)
          (answer "groups.log" (hermes-groups-test--page nil 0 0))
          (answer "groups.state" state)
          (when (memq fault '(readiness cursor))
            (setf (hermes-dashboard-transport-client-ready-p client) nil
                  (hermes-dashboard-transport-client-ready-promise client) (hermes--promise-make)))
          (pcase fault
            ('request (setf (alist-get 'request_id (car (alist-get 'pending_actions hermes-groups--driver))) "successor"))
            ('epoch (setf (alist-get 'authority_epoch hermes-groups--room) 2))
            ('roster (setf (alist-get 'profile (car (alist-get 'members hermes-groups--room))) "successor"))
            ('file (set-visited-file-name (expand-file-name "notes" temporary-file-directory) t)
                   (set-visited-file-name nil t)))
          (if (eq fault 'terminal)
              (answer "groups.log" (hermes-groups-test--page (list (hermes-groups-test--terminal 1 "turn.cancelled" "task")) 1 1))
            (answer "groups.log" (hermes-groups-test--page nil 0 0)))
          (when (memq fault '(readiness cursor))
            (let ((ready (hermes-dashboard-transport-client-ready-promise client)))
              (if (eq fault 'cursor) (setq hermes-groups--cursor 1)
                (setf (alist-get 'request_id (car (alist-get 'pending_actions hermes-groups--driver))) "successor"))
              (setf (hermes-dashboard-transport-client-ready-p client) t)
              (hermes--promise-resolve ready client)))
          (if fault
              (progn (should-not frames) (should-not (member "groups.approve" all-methods)))
            (should (equal (alist-get 'method (car frames)) "groups.approve"))))))))

