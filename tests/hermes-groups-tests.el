;;; hermes-groups-tests.el --- Hosted room read journeys -*- lexical-binding: t; -*-

;;; Code:
(require 'hermes-test-helpers)
(require 'hermes-groups)

(defconst hermes-groups-test--capabilities
  '((protocol_version . 2) (driver . :false) (persistent_process . :false)
    (authority_gateway_id . "gateway") (room_link . ((enabled . :false)))
    (features . ("authority_epoch" "room_identity" "monotonic_log" "typed_events"
                 "actor_identity" "replayable_disband"))
    (methods . ("groups.capabilities" "groups.list" "groups.state" "groups.log"))
    (max_log_limit . 500)))

(defun hermes-groups-test--room (&optional epoch disbanded)
  "Return a complete synthetic room at EPOCH with optional DISBANDED state."
  `((room_id . "room") (name . "Discussion")
    (members . (((member_id . "a") (display_name . "Athena") (profile . "test"))))
    (authority_gateway_id . ,(if (eql epoch 2) "successor" "gateway"))
    (authority_epoch . ,(or epoch 1)) (revision . 1)
    (created_at . 1.0) (updated_at . 2.0) (latest_seq . 3)
    ,@(and disbanded '((disbanded_at . 3.0)))))

(defun hermes-groups-test--event (seq &optional kind epoch)
  "Return synthetic SEQ event with optional KIND and EPOCH."
  `((room_id . "room") (seq . ,seq) (event_id . ,(format "event-%s" seq))
    (kind . ,(or kind "message.member"))
    (actor . ((kind . "member") (id . "a") (display_name . "Athena")))
    (authority_epoch . ,(or epoch 1)) (created_at . ,(float seq)) (idempotent . :false)
    (payload . ((text . ,(format "Literal public message %s" seq)) (member_id . "a")
                (task_id . "task") (thread_id . "thread") (turn_id . "turn")
                (status . "failed") (error . "No inference in this fixture")))))

(defun hermes-groups-test--page (events cursor latest &optional epoch)
  "Return EVENTS page with CURSOR, LATEST and optional EPOCH."
  `((events . ,events) (cursor . ,cursor) (latest_seq . ,latest)
    (has_more . ,(if (< cursor latest) t :false))
    (authority . ((gateway_id . ,(if (eql epoch 2) "successor" "gateway"))
                  (epoch . ,(or epoch 1))))))

(defmacro hermes-groups-test--wire (&rest body)
  "Run BODY with native acquisition/request ownership and controlled wire replies."
  (declare (indent 0) (debug t))
  `(let* ((instance (cons "groups-test" "http://groups.invalid"))
          (hermes-instances (list instance))
          (hermes-instance nil)
          (client (make-hermes-dashboard-transport-client
                   :base-url "http://groups.invalid" :websocket 'test-socket :ready-p t))
          (json-false :false)
          (before (buffer-list)) (released 0) frames all-methods
          (hermes-dashboard-transport-websocket-send-function
           (lambda (_socket text)
             (let ((frame (hermes-dashboard-transport--decode-frame text)))
               (push (alist-get 'method frame) all-methods)
               (setq frames (append frames (list frame)))))))
     (cl-letf (((symbol-function 'hermes-dashboard-transport-acquire)
                (lambda (&rest _) client))
               ((symbol-function 'hermes-dashboard-transport-release)
                (lambda (_) (cl-incf released)))
               ((symbol-function 'hermes-browser--existing-client) (lambda () nil))
               ((symbol-function 'websocket-close) #'ignore))
       (cl-labels ((answer (method result &optional errorp)
                     (let ((frame (pop frames)))
                       (should (equal (alist-get 'method frame) method))
                       (hermes-dashboard-transport--handle-frame
                        client (json-encode
                                `((jsonrpc . "2.0") (id . ,(alist-get 'id frame))
                                  (,(if errorp 'error 'result) . ,result))))))
                   (state (&optional epoch disbanded)
                     (answer "groups.capabilities" hermes-groups-test--capabilities)
                     (answer "groups.state" `((room . ,(hermes-groups-test--room epoch disbanded)))))
                   (view ()
                     (hermes-groups--buffer instance "room")))
         (unwind-protect (progn ,@body)
           (dolist (buffer (seq-difference (buffer-list) before))
             (when (buffer-live-p buffer) (kill-buffer buffer)))
           (hermes-dashboard-transport-stop client))))))

(ert-deftest hermes-groups-public-read-only-entry ()
  (should (commandp 'hermes-list-groups))
  (hermes-groups-test--wire
    (save-window-excursion
      (let ((listing (hermes-list-groups)))
        (should (eq (window-buffer) listing))
        (answer "groups.capabilities" hermes-groups-test--capabilities)
        (answer "groups.list" `((rooms . (,(hermes-groups-test--room))) (next_offset . 713)))
        (with-current-buffer listing
          (should (string-match-p "unavailable (history readable)" (hermes-groups--header)))
          (call-interactively (key-binding (kbd "m"))))
        (answer "groups.capabilities" hermes-groups-test--capabilities)
        (should (= (alist-get 'offset (alist-get 'params (car frames))) 713))
        (answer "groups.list" `((rooms . (,(hermes-groups-test--room))) (next_offset)))
        (with-current-buffer listing
          (goto-char (point-min)) (forward-line 2)
          (call-interactively (key-binding (kbd "RET"))))
        (state)
        (answer "groups.log" (hermes-groups-test--page (list (hermes-groups-test--event 1)) 1 3))
        (should (= (alist-get 'since_seq (alist-get 'params (car frames))) 1))
        (answer "groups.log" (hermes-groups-test--page
                              (list (hermes-groups-test--event 1)
                                    (hermes-groups-test--event 2 "turn.failed")
                                    (hermes-groups-test--event 3)) 3 3))
        (with-current-buffer (view)
          (should buffer-read-only)
          (should (= hermes-groups--cursor 3))
          (should (= (length hermes-groups--events) 3))
          (should (= (how-many "Literal public message 1" (point-min) (point-max)) 1))
          (should (string-match-p "Athena" (buffer-string)))
          (should (string-match-p "turn.failed" (buffer-string)))
          (should (string-match-p "Worker: unknown" (buffer-string)))
          (should-not (local-variable-p 'hermes-chat--state))
          (goto-char (point-min))
          (let ((line (line-number-at-pos)))
            (execute-kbd-macro (kbd "n"))
            (should (= (line-number-at-pos) (1+ line))))))
      (should-not frames)
      (should (= released 3))
      (should (seq-every-p (lambda (method) (member method '("groups.capabilities" "groups.list"
                                                            "groups.state" "groups.log")))
                          all-methods)))))

