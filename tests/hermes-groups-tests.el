(ert-deftest hermes-groups-native-hooks-retain-accepted-transaction ()
  (dolist (phase '(state log))
    (dolist (hook '(before-change-functions after-change-functions))
      (dolist (fault '(error quit edit))
        (hermes-groups-test--wire
          (with-current-buffer (view)
            (hermes-groups-refresh) (state)
            (answer "groups.log" (hermes-groups-test--page (list (hermes-groups-test--event 1)) 1 1))
            (hermes-groups-refresh)
            (answer "groups.capabilities" hermes-groups-test--capabilities)
            (when (eq phase 'log)
              (answer "groups.state" `((room . ,(hermes-groups-test--room)))))
            (let ((text (buffer-string)) (room hermes-groups--room)
                  (events hermes-groups--events)
                  (fn (lambda (&rest _)
                        (if (eq fault 'edit)
                            (let ((inhibit-read-only t) (inhibit-modification-hooks t))
                              (erase-buffer) (insert "same-owner replacement"))
                          (signal fault '("native hook fault"))))))
              (add-hook hook fn nil t)
              (if (eq phase 'state)
                  (answer "groups.state" `((room . ,(hermes-groups-test--room 2))))
                (answer "groups.log" (hermes-groups-test--page (list (hermes-groups-test--event 2)) 2 2)))
              (remove-hook hook fn t)
              (should (equal-including-properties text (buffer-string)))
              (should (eq room hermes-groups--room))
              (should (eq events hermes-groups--events))
              (should (= hermes-groups--cursor 1))
              (should-not frames)
              (should-not hermes-browser--owned-cleanup))
            (hermes-groups-refresh) (state 2)
            (answer "groups.log" (hermes-groups-test--page
                                  (list (hermes-groups-test--event 1 nil 2)
                                        (hermes-groups-test--event 2 nil 2)) 2 2 2))
            (should (= hermes-groups--cursor 2))
            (should (string-match-p "Literal public message 2" (buffer-string)))))))))

(ert-deftest hermes-groups-native-hooks-fence-original-read ()
  (dolist (phase '(state log))
    (dolist (hook '(before-change-functions after-change-functions))
      (dolist (retirement '(stop endpoint room))
        (hermes-groups-test--wire
          (with-current-buffer (view)
            (hermes-groups-refresh) (state)
            (answer "groups.log" (hermes-groups-test--page (list (hermes-groups-test--event 1)) 1 1))
            (hermes-groups-refresh)
            (answer "groups.capabilities" hermes-groups-test--capabilities)
            (when (eq phase 'log)
              (answer "groups.state" `((room . ,(hermes-groups-test--room)))))
            (let ((text (buffer-string)) (room hermes-groups--room)
                  (fn (lambda (&rest _)
                        (pcase retirement
                          ('stop (hermes-dashboard-transport-stop client))
                          ('endpoint (setf (hermes-dashboard-transport-client-base-url client)
                                           "http://replacement.invalid"))
                          ('room (setq hermes-groups--room-id "replacement"))))))
              (add-hook hook fn nil t)
              (if (eq phase 'state)
                  (answer "groups.state" `((room . ,(hermes-groups-test--room 2))))
                (answer "groups.log" (hermes-groups-test--page (list (hermes-groups-test--event 2)) 2 3)))
              (remove-hook hook fn t)
              (should (= hermes-groups--cursor 1))
