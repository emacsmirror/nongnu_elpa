(ert-deftest hermes-groups-backend-qualified-constructors-preserve-foreign-buffers ()
  (let* ((a (cons "same" "http://a.invalid")) (b (cons "same" "http://b.invalid"))
         (foreign (generate-new-buffer "*Hermes Groups: same / room*"))
         first second)
    (unwind-protect
        (progn
          (with-current-buffer foreign (insert "unrelated text"))
          (setq first (hermes-groups--buffer a "room") second (hermes-groups--buffer b "room"))
          (should-not (eq first foreign)) (should-not (eq first second))
          (should (eq first (hermes-groups--buffer a "room")))
          (should (equal (with-current-buffer foreign (buffer-string)) "unrelated text")))
      (mapc #'kill-buffer (delq nil (list first second foreign))))))

