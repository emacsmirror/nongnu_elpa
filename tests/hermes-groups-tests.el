(ert-deftest hermes-groups-follow-timer-is-bounded-and-retired ()
  (hermes-groups-test--wire
    (let ((schedule (symbol-function 'run-at-time)) callback owned-timer)
      (cl-letf (((symbol-function 'run-at-time)
                 (lambda (time repeat fn &rest args)
                   (let ((timer (apply schedule time repeat fn args)))
                     (when (eql time 5) (setq callback fn owned-timer timer))
                     timer))))
        (with-current-buffer (view)
          (hermes-groups-follow) (state)
          (answer "groups.log" (hermes-groups-test--page nil 0 0))
          (should hermes-groups--timer-cleanup)
          (should (memq owned-timer timer-list))
          (funcall callback)
          (should-not (memq owned-timer timer-list))
          (dotimes (n 3)
            (answer "groups.capabilities" '((code . -32603) (message . "read failed")) t)
            (when (< n 2) (funcall callback)))
          (should-not hermes-groups--follow)
          (should-not hermes-groups--timer-cleanup)
          (hermes-groups-follow) (state)
          (answer "groups.log" (hermes-groups-test--page nil 0 0))
          (should hermes-groups--timer-cleanup)
          (hermes-dashboard-transport-stop client)
          (should-not hermes-groups--timer-cleanup)
          (should-not (memq owned-timer timer-list))
          (funcall callback)
          (should-not frames))))))

