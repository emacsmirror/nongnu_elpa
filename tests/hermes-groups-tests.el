(ert-deftest hermes-groups-malformed-cursors-and-conflicting-replays-refused ()
  (let* ((room (hermes-groups-test--room)) (event (hermes-groups-test--event 1))
         (base (hermes-groups-test--page nil 1 1)))
    (dolist (change '((cursor) (cursor . 9) (latest_seq . 0) (has_more . t)
                      (has_more . "false") (authority . ((gateway_id . "other") (epoch . 1)))))
      (let ((page (copy-tree base)))
        (setf (alist-get (car change) page) (cdr change))
        (should-error (hermes-groups--page-events page room (list event) 1)
                      :type 'hermes-groups-reconcile)))
    (let ((conflict (hermes-groups-test--event 2)))
      (setf (alist-get 'event_id conflict) "event-1")
      (should-error (hermes-groups--page-events (hermes-groups-test--page (list conflict) 2 2)
                                               room (list event) 1)
                    :type 'hermes-groups-reconcile))
    (should (equal (hermes-groups--page-events (hermes-groups-test--page (list event) 1 1)
                                              room (list event) 1) nil))))

(ert-deftest hermes-groups-retirement-fences-delayed-wire-and-native-commands ()
  (dolist (retirement '(mode file detach kill stop backend))
    (hermes-groups-test--wire
      (let ((buffer (view)))
        (with-current-buffer buffer
          (hermes-groups-refresh) (state)
          (pcase retirement
            ('mode (fundamental-mode)
                   (let ((inhibit-read-only t)) (erase-buffer) (insert "user notes")))
            ('file (set-visited-file-name (expand-file-name "notes" temporary-file-directory) t)
                   (let ((inhibit-read-only t)) (erase-buffer) (insert "user notes")))
            ('detach (set-visited-file-name (expand-file-name "notes" temporary-file-directory) t)
                     (set-visited-file-name nil t)
                     (let ((inhibit-read-only t)) (erase-buffer) (insert "user notes")))
            ('kill (kill-buffer buffer))
            ('stop (hermes-dashboard-transport-stop client))
            ('backend (hermes-browser--own-instance (cons "other" "http://other.invalid"))))
          (answer "groups.log" (hermes-groups-test--page (list (hermes-groups-test--event 1)) 1 1)))
        (should (= (hash-table-count (hermes-dashboard-transport-client-pending client)) 0))
        (should (= released 1))
        (when (buffer-live-p buffer)
          (with-current-buffer buffer
            (should-not (string-match-p "Literal public" (buffer-string)))
            (when (memq retirement '(file detach mode))
              (should (equal (buffer-string) "user notes"))
              (should-error (hermes-groups-refresh) :type 'user-error))))))))

