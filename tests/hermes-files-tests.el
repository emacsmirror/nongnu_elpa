(defconst hermes-files-test--png
  (base64-decode-string
   "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAIAAACQd1PeAAAADElEQVR4nGP4z8AAAAMBAQDJ/pLvAAAAAElFTkSuQmCC"))

(ert-deftest hermes-files-preview-unicode-and-save-original ()
  (hermes-files-test--with-api
    (hermes-files)
    (push (current-buffer) buffers)
    (hermes--promise-resolve (nth 3 (car calls)) (hermes-files-test--listing))
    (goto-char (point-min))
    (hermes-files-open)
    (push (current-buffer) buffers)
    (let* ((text "Καλημέρα — café 世界\r\n")
           (bytes (encode-coding-string text 'utf-8-unix))
           (directory (make-temp-file "hermes-preview-" t))
           (path (expand-file-name "original" directory)))
      (unwind-protect
          (progn
            (hermes--promise-resolve
             (nth 3 (car calls))
             (list :path "/remote/file0.el" :size (length bytes)
                   :data_url (concat "data:application/octet-stream;base64,"
                                     (base64-encode-string bytes t))))
            (should (equal (buffer-string) text))
            (should (string-match-p "UTF-8 text" header-line-format))
            (should (string-match-p "/remote/file0.el" header-line-format))
            (should (equal (secure-hash 'sha256 hermes-files--bytes)
                           (secure-hash 'sha256 bytes)))
            (hermes-file-save path)
            (with-temp-buffer
              (set-buffer-multibyte nil)
              (insert-file-contents-literally path)
              (should (equal (buffer-string) bytes))))
        (delete-directory directory t)))))

