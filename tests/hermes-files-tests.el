(ert-deftest hermes-files-retains-existing-chat-client ()
  (dolist (teardown '(kill mode))
    (hermes-files-test--with-api
      (let ((chat (generate-new-buffer " *files chat*")))
        (push chat buffers)
        (switch-to-buffer chat)
        (hermes-chat-mode)
        (setq-local hermes-instance instance hermes-chat--dashboard-client client)
        (setf (hermes-dashboard-transport-client-websocket client) 'test-socket
              (hermes-dashboard-transport-client-refcount client) 1)
        (call-interactively #'hermes-files)
        (push (current-buffer) buffers)
        (let ((browser (current-buffer)))
          (should (eq hermes-files--client client))
          (should (= 2 (hermes-dashboard-transport-client-refcount client)))
          (with-current-buffer chat (setq hermes-chat--dashboard-client nil))
          (hermes-dashboard-transport-release client)
          (should (= 1 (hermes-dashboard-transport-client-refcount client)))
          (should-not (hermes-dashboard-transport-client-stopping-p client))
          (hermes--promise-resolve (nth 3 (car calls)) (hermes-files-test--listing))
          (goto-char (point-min))
          (call-interactively (key-binding (kbd "RET")))
          (push (current-buffer) buffers)
          (hermes--promise-resolve (nth 3 (car calls)) (hermes-files-test--read))
          (should hermes-files--bytes)
          (with-current-buffer browser
            (if (eq teardown 'kill) (kill-buffer browser) (fundamental-mode)))
          (should (= 0 (hermes-dashboard-transport-client-refcount client)))
          (should (hermes-dashboard-transport-client-stopping-p client))
          (when (buffer-live-p browser) (kill-buffer browser))
          (should (= 0 (hermes-dashboard-transport-client-refcount client)))
          (should (= releases 2)))))))

(ert-deftest hermes-files-retirement-settles-exact-viewer-synchronously ()
  (dolist (retire '(refresh cancel second-open kill mode))
    (dolist (completion '(resolve reject))
      (hermes-files-test--with-api
        (call-interactively #'hermes-files)
        (push (current-buffer) buffers)
        (hermes--promise-resolve (nth 3 (car calls)) (hermes-files-test--listing))
        (goto-char (point-min))
        (let ((browser (current-buffer)))
          (call-interactively (key-binding (kbd "RET")))
          (push (current-buffer) buffers)
          (let ((viewer (current-buffer)) (request (nth 3 (car calls))))
            (switch-to-buffer browser)
            (pcase retire
              ('refresh (call-interactively (key-binding "g")))
              ('cancel (call-interactively (key-binding (kbd "C-g"))))
              ('second-open (call-interactively (key-binding (kbd "RET")))
                            (push (current-buffer) buffers))
              ('kill (kill-buffer browser))
              ('mode (fundamental-mode)))
            (let ((window (selected-window)) (buffer (current-buffer))
                  (position (point))
                  (snapshot (with-current-buffer viewer
                              (should (equal hermes-files--status "Cancelled"))
                              (should (string-match-p "cancelled" header-line-format))
                              (list (buffer-string) header-line-format mode-line-process))))
              (if (eq completion 'resolve)
                  (hermes--promise-resolve request (hermes-files-test--read))
                (hermes--promise-reject request "Late private rejection"))
              (should (eq window (selected-window)))
              (should (eq buffer (current-buffer)))
              (should (= position (point)))
              (with-current-buffer viewer
                (should-not hermes-files--bytes)
                (should (equal snapshot
                               (list (buffer-string) header-line-format mode-line-process)))))
            (when (eq retire 'second-open)
              (should (equal hermes-files--status "Loading"))
              (hermes--promise-resolve (nth 3 (car calls)) (hermes-files-test--read))
              (should hermes-files--bytes))))))))

