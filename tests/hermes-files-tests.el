(ert-deftest hermes-files-window-metrics-respect-gutters-and-face-width ()
  (hermes-files-test--with-api
    (hermes-files)
    (push (current-buffer) buffers)
    (let* ((browser (current-buffer))
           (first (selected-window)) (second (split-window-right)))
      (set-window-buffer second browser)
      ;; Controlled metrics distinguish frame columns from remapped text
      ;; pixels; actual window selection and caller-point restoration are real.
      (cl-letf (((symbol-function 'window-body-width)
                 (lambda (_window &optional pixelwise) (if pixelwise 800 80)))
                ((symbol-function 'window-font-width)
                 (lambda (&optional window _face) (if (eq window first) 10 20)))
                ((symbol-function 'frame-char-width)
                 (lambda (&rest _) (ert-fail "Frame font used for text viewport")))
                ((symbol-function 'line-number-display-width)
                 (lambda (&optional _pixelwise)
                   (should display-line-numbers)
                   (if (eq (selected-window) first) 20 80))))
        (let ((display-line-numbers nil)
              (reserve (+ 1 tabulated-list-padding 9 12 2)))
          (should (= (+ reserve (hermes-files--name-width)) 40))
          (let ((display-line-numbers t))
            (should (= (+ reserve (hermes-files--name-width)) 36)))
          (should (eq first (selected-window)))
          (should (eq browser (current-buffer))))))))

