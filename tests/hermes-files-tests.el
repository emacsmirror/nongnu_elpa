(ert-deftest hermes-files-transport-retirement-settles-public-open ()
  (dolist (retire '(stop process-exit reconnect))
    (dolist (completion '(resolve reject))
      (hermes-files-test--with-api
        (call-interactively #'hermes-files)
        (push (current-buffer) buffers)
        (hermes--promise-resolve (nth 3 (car calls)) (hermes-files-test--listing))
        (should-not hermes-files--subscription)
        (goto-char (point-min))
        (let ((browser (current-buffer)))
          (call-interactively (key-binding (kbd "RET")))
          (push (current-buffer) buffers)
          (let* ((viewer (current-buffer)) (request (nth 3 (car calls)))
                 (observer (plist-get
                            (gethash (buffer-local-value 'hermes-files--subscription browser)
                                     (hermes-dashboard-transport-client-subscribers client)) :retire))
                 (typing (generate-new-buffer " *transport retirement draft*"))
                 successor)
            (push typing buffers)
            (switch-to-buffer typing)
            (hermes-chat-mode)
            (buffer-enable-undo)
            (goto-char (point-max))
            (insert "unsent exact draft")
            (let ((window (selected-window)) (position (point))
                  (undo (copy-tree buffer-undo-list)) (text (buffer-string)))
              (message "Transport retirement: %s / %s" retire completion)
              (pcase retire
                ('stop (hermes-dashboard-transport-stop client "Disconnected"))
                ('process-exit
                 (let ((process (make-pipe-process :name "files-exit-test" :noquery t)))
                   (setf (hermes-dashboard-transport-client-process client) process)
                   (delete-process process)
                   (hermes-dashboard-transport--handle-process-exit
                    client process (hermes-dashboard-transport-client-process-generation client))))
                ('reconnect
                 (cl-letf (((symbol-function 'hermes-dashboard-transport--arm-ready-timeout) #'ignore)
                           ((symbol-function 'hermes-dashboard-transport--reconnect-attempt) #'ignore))
                   (hermes-dashboard-transport-reconnect client))))
              ;; Settlement must precede either HTTP completion and must not
              ;; move the reader while retiring the unselected file views.
              (should (eq window (selected-window)))
              (should (eq typing (current-buffer)))
              (should (= position (point)))
              (should (equal undo buffer-undo-list))
              (should (equal text (buffer-string)))
              (with-current-buffer viewer
                (should (equal hermes-files--status "Cancelled"))
                (should (string-match-p "cancelled" header-line-format))
                (should-not hermes-files--bytes))
              (with-current-buffer browser
                (should (equal hermes-files--status "Cancelled"))
                (should (equal (eval (cadr mode-line-process)) " Cancelled"))
                (should-not hermes-files--pending-viewer)
                (should-not hermes-files--subscription)
                ;; A successor request on the current generation owns its own
                ;; viewer; old event delivery must not cancel either.
                (call-interactively #'hermes-files-open)
                (setq successor (current-buffer)))
              (progn
                (push successor buffers)
                (select-window window)
                (switch-to-buffer typing)
                (funcall observer)
                (if (eq completion 'resolve)
                    (hermes--promise-resolve request (hermes-files-test--read))
                  (hermes--promise-reject request "Late private body"))
                (with-current-buffer successor
                  (should (equal hermes-files--status "Loading"))
                  (should-not hermes-files--bytes))
                (hermes--promise-resolve (nth 3 (car calls)) (hermes-files-test--read))
                (with-current-buffer successor
                  (should (equal hermes-files--status "Ready"))
                  (should hermes-files--bytes)))
              (should (eq window (selected-window)))
              (should (eq typing (current-buffer)))
              (should (= position (point)))
              (should (equal undo buffer-undo-list))
              (should (equal text (buffer-string)))
              (with-current-buffer viewer
                (should (equal hermes-files--status "Cancelled"))
                (should-not hermes-files--bytes)))))))))

