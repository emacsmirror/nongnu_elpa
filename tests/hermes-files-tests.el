(ert-deftest hermes-files-popup-exact-dismiss-cancel-and-quit ()
  ;; Exercise the transient wrapper, not just the ordinary mode map.
  (dolist (keys '("? q" "? <escape>" "? C-g" "C-g" "q"))
    (hermes-files-test--with-api
      (hermes-files)
      (push (current-buffer) buffers)
      (hermes--promise-resolve (nth 3 (car calls)) (hermes-files-test--listing))
      (goto-char (point-min))
      (let ((browser (current-buffer)))
        (hermes-files-open)
        (push (current-buffer) buffers)
        (let ((viewer (current-buffer)) (request (nth 3 (car calls))))
          (switch-to-buffer browser)
          (unwind-protect
              (progn
                (when (string-prefix-p "?" keys)
                  (execute-kbd-macro (kbd "?"))
                  (with-current-buffer keymap-popup--buffer-name
                    (dolist (label '("Dismiss menu" "Cancel read" "Quit view"))
                      (should (string-match-p label (buffer-string))))))
                (execute-kbd-macro
                 (kbd (if (string-prefix-p "? " keys) (substring keys 2) keys)))
                (should-not (get-buffer-window keymap-popup--buffer-name))
                (if (equal keys "? <escape>")
                    (progn
                      (should (eq (current-buffer) browser))
                      (should (equal hermes-files--status "Loading"))
                      (should hermes-files--pending-viewer)
                      (hermes--promise-resolve request (hermes-files-test--read))
                      (should (buffer-local-value 'hermes-files--bytes viewer)))
                  (if (string-suffix-p "q" keys)
                      (should-not (eq (window-buffer) browser))
                    (should (eq (current-buffer) browser))))
                (unless (equal keys "? <escape>")
                  (with-current-buffer browser
                    (should (equal hermes-files--status "Cancelled"))
                    (should-not hermes-files--pending-viewer))
                  (with-current-buffer viewer
                    (should (equal hermes-files--status "Cancelled")))
                  (hermes--promise-resolve request (hermes-files-test--read))
                  (should-not (buffer-local-value 'hermes-files--bytes viewer))))
            (keymap-popup-dismiss)))))))

(ert-deftest hermes-files-native-columns-survive-async-render-and-resize ()
  (hermes-files-test--with-api
    (hermes-files)
    (push (current-buffer) buffers)
    (hermes--promise-resolve (nth 3 (car calls)) (hermes-files-test--listing 100))
    (let ((header (format "%s" header-line-format)))
      (dolist (label '("Name" "Kind" "Bytes"))
        (should (string-match-p label header))))
    (let* ((browser (current-buffer))
           (wide (selected-window))
           (original-width (cadar (append tabulated-list-format nil)))
           (narrow (split-window-right))
           (typing (generate-new-buffer " *files resize draft*")))
      (push typing buffers)
      (set-window-buffer narrow browser)
      (goto-char (point-min))
      (forward-line 40)
      (move-to-column 3)
      (set-window-start wide (save-excursion (forward-line -10) (point)) t)
      (set-window-start narrow (save-excursion (forward-line -20) (point)) t)
      (set-window-point narrow (save-excursion (forward-line 5) (point)))
      (let ((anchors (mapcar
                      (lambda (w) (list w (hermes-files--position (window-start w))
                                        (hermes-files--position (window-point w))))
                      (list wide narrow)))
            (position (hermes-files--position (point))))
        (hermes-files-refresh)
        (hermes--promise-resolve (nth 3 (car calls)) (hermes-files-test--listing 100))
        (should (< (cadar (append tabulated-list-format nil)) original-width))
        (should (equal (seq-take position 3)
                       (seq-take (hermes-files--position (point)) 3)))
        (pcase-dolist (`(,window ,start ,point) anchors)
          (should (equal (seq-take start 3)
                         (seq-take (hermes-files--position (window-start window)) 3)))
          (should (equal (seq-take point 3)
                         (seq-take (hermes-files--position (window-point window)) 3)))))
      (select-window narrow)
      (switch-to-buffer typing)
      (hermes-chat-mode)
      (buffer-enable-undo)
      (goto-char (point-max))
      (insert "Unsent exact draft")
      (let ((text (buffer-string)) (position (point)) (undo (copy-tree buffer-undo-list))
            (start (window-start wide)) (browser-point (window-point wide))
            (start-row (with-current-buffer browser
                         (seq-take (hermes-files--position (window-start wide)) 3)))
            (point-row (with-current-buffer browser
                         (seq-take (hermes-files--position (window-point wide)) 3))))
        (delete-window wide)
        (setq wide (split-window-below))
        (set-window-buffer wide browser)
        (set-window-start wide start t)
        (set-window-point wide browser-point)
        ;; Batch redisplay does not deliver configuration hooks.  Call the
        ;; installed local hook with the same window context as real redisplay.
        (with-current-buffer browser
          (run-hooks 'window-configuration-change-hook))
        (should (eq (current-buffer) typing))
        (should (= position (point)))
        (should (equal text (buffer-string)))
        (should (equal undo buffer-undo-list))
        (with-current-buffer browser
          (should (equal start-row
                         (seq-take (hermes-files--position (window-start wide)) 3)))
          (should (equal point-row
                         (seq-take (hermes-files--position (window-point wide)) 3))))
        (with-current-buffer browser
          (should (= (cadar (append tabulated-list-format nil)) original-width))
          (dolist (label '("Name" "Kind" "Bytes"))
            (should (string-match-p label (format "%s" header-line-format)))))))))

