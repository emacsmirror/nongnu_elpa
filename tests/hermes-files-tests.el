(require 'ert)
(require 'hermes-test-helpers)
(require 'hermes-files)

(ert-deftest hermes-files-public-command ()
  (should (commandp 'hermes-files))
  (should (eq (lookup-key hermes-dashboard-mode-map (kbd "O")) 'hermes-files)))

(defmacro hermes-files-test--with-api (&rest body)
  (declare (indent 0))
  `(let* ((instance '("Files test" . "http://files.invalid"))
          (hermes-instances (list instance))
          (hermes-instance instance)
          (hermes-dashboard-transport--clients (make-hash-table :test #'equal))
          (hermes-dashboard-transport-idle-close-delay 0)
          (client (make-hermes-dashboard-transport-client
                   :base-url (cdr instance)))
          (release (symbol-function 'hermes-dashboard-transport-release))
          (releases 0) calls buffers)
     (save-window-excursion
       (cl-letf (((symbol-function 'hermes-dashboard-transport-start)
                  (lambda (&rest _) client))
                 ((symbol-function 'hermes-dashboard-transport-release)
                  (lambda (owner) (cl-incf releases) (funcall release owner)))
                 ((symbol-function 'hermes-dashboard-transport-api-request-async)
                  (lambda (method path &rest args)
                    (let ((promise (hermes--promise-make)))
                      (push (list method path args promise) calls)
                      promise))))
         (unwind-protect (progn ,@body)
           (dolist (buffer buffers)
             (when (buffer-live-p buffer) (kill-buffer buffer))))))))

(defun hermes-files-test--routing-during-request (legacy)
  "Check event delivery across a public Files request, using LEGACY routing."
  (hermes-files-test--with-api
    (let (events)
      (if legacy
          (setf (hermes-dashboard-transport-client-callback client)
                (lambda (event) (push event events)))
        (hermes-dashboard-transport-subscribe
         client (lambda (event) (push event events))))
      (cl-flet ((dispatch (phase)
                  (hermes-dashboard-transport--dispatch-event
                   client (if legacy
                              (list :type 'status :status phase)
                            (list :type 'delta :session-id "new-session"
                                  :content phase)))))
        (dispatch "before")
        (call-interactively #'hermes-files)
        (push (current-buffer) buffers)
        (should (equal (cadar calls) "/api/files"))
        (should (equal hermes-files--status "Loading"))
        (dispatch "during")
        (hermes--promise-resolve (nth 3 (car calls))
                                (hermes-files-test--listing))
        (should (equal hermes-files--status "Ready"))
        (should-not hermes-files--subscription)
        (dispatch "after")
        (should (equal (mapcar (lambda (event)
                                (plist-get event (if legacy :status :content)))
                              (reverse events))
                       '("before" "during" "after")))))))

(ert-deftest hermes-files-observation-preserves-bootstrap-routing ()
  (hermes-files-test--routing-during-request nil))

(ert-deftest hermes-files-observation-preserves-legacy-routing ()
  (hermes-files-test--routing-during-request t))

(ert-deftest hermes-files-observation-has-no-session-ownership ()
  (hermes-files-test--with-api
    (let* (events
           (token (hermes-dashboard-transport-subscribe
                   client (lambda (event) (push event events)))))
      (hermes-dashboard-transport-subscribe-session client token "chat")
      (call-interactively #'hermes-files)
      (push (current-buffer) buffers)
      (should-error (hermes-dashboard-transport-subscribe-session
                     client hermes-files--subscription "chat"))
      (dolist (event '((:type status :status "Ready")
                       (:type delta :session-id "chat" :content "reply")))
        (hermes-dashboard-transport--dispatch-event client event))
      (should (= 2 (length events)))
      (hermes-dashboard-transport-set-subscriber-fn client token nil)
      (should-not (gethash "chat" (hermes-dashboard-transport-client-session-index
                                 client)))
      (should-not (hermes-dashboard-transport--event-subscribers client))
      (setf (hermes-dashboard-transport-client-callback client)
            (lambda (event) (push event events)))
      (hermes-dashboard-transport--dispatch-event
       client '(:type delta :session-id "chat" :content "legacy"))
      (should (= 3 (length events))))))

(ert-deftest hermes-files-navigation-and-stale-refresh ()
  (hermes-files-test--with-api
    (hermes-files)
    (push (current-buffer) buffers)
    (should (equal (caar calls) "GET"))
    (should (equal (cadar calls) "/api/files"))
    (hermes--promise-resolve (nth 3 (car calls))
                            '(:path "/remote" :parent "/" :entries
                              ((:name "child" :path "/remote/a & b" :is_directory t))))
    (goto-char (point-min))
    (call-interactively (key-binding (kbd "RET")))
    (should (equal (plist-get (nth 2 (car calls)) :query)
                   '((path . "/remote/a & b"))))
    (let ((old (nth 3 (car calls))))
      (call-interactively (key-binding (kbd "g")))
      (hermes--promise-resolve (nth 3 (car calls))
                              '(:path "/remote/a & b" :parent "/remote" :entries nil))
      (hermes--promise-resolve old '(:path "/wrong" :entries nil))
      (should (equal hermes-files--path "/remote/a & b"))
      (call-interactively (key-binding (kbd "^")))
      (should (equal (plist-get (nth 2 (car calls)) :query)
                     '((path . "/remote")))))))

(defun hermes-files-test--listing (&optional count)
  (list :path "/remote" :parent nil :entries
        (cl-loop for i below (or count 1) collect
                 (list :name (format "file%d.el" i)
                       :path (format "/remote/file%d.el" i)
                       :is_directory :false :size 3))))

(defun hermes-files-test--read ()
  '(:path "/remote/file0.el" :size 3 :data_url "data:application/octet-stream;base64,AP9B"))

(ert-deftest hermes-files-read-is-inert-and-does-not-steal-focus ()
  (hermes-files-test--with-api
    (hermes-files)
    (push (current-buffer) buffers)
    (hermes--promise-resolve (nth 3 (car calls)) (hermes-files-test--listing))
    (goto-char (point-min))
    (call-interactively (key-binding (kbd "RET")))
    (push (current-buffer) buffers)
    (let ((viewer (current-buffer)) (request (nth 3 (car calls)))
          (other (generate-new-buffer " *typing*")))
      (push other buffers)
      (switch-to-buffer other)
      (hermes-chat-mode)
      (goto-char (point-max))
      (insert "unsent draft")
      (let ((position (point)) (window (selected-window)))
        (hermes--promise-resolve request (hermes-files-test--read))
        (should (eq (selected-window) window))
        (should (eq (current-buffer) other))
        (should (= (point) position))
        (should (equal (buffer-substring-no-properties
                        hermes-chat--input-marker (point-max)) "unsent draft")))
      (with-current-buffer viewer
        (should (eq major-mode 'hermes-file-view-mode))
        (should buffer-read-only)
        (should-not buffer-file-name)
        (should (string-match-p "Binary" header-line-format))
        (should-not (string-match-p "\0" (buffer-string)))
        (should (equal hermes-files--bytes (unibyte-string 0 255 65)))))))

(ert-deftest hermes-files-read-retired-owners-never-complete ()
  (dolist (retire '(refresh cancel viewer-cancel viewer-kill browser-kill
                           instance connection mode))
    (hermes-files-test--with-api
      (hermes-files)
      (push (current-buffer) buffers)
      (hermes--promise-resolve (nth 3 (car calls)) (hermes-files-test--listing))
      (goto-char (point-min))
      (let ((browser (current-buffer)))
        (hermes-files-open)
        (push (current-buffer) buffers)
        (let ((viewer (current-buffer)) (request (nth 3 (car calls))))
          (pcase retire
            ('viewer-cancel (call-interactively (key-binding (kbd "C-g"))))
            ('viewer-kill (kill-buffer viewer))
            ('browser-kill (kill-buffer browser))
            (_ (with-current-buffer browser
                 (pcase retire
                   ('refresh (hermes-files-refresh))
                   ('cancel (hermes-files-cancel))
                   ('instance (setq hermes-instance '("other" . "http://other.test")))
                   ('connection (cl-incf (hermes-dashboard-transport-client-generation client)))
                   ('mode (fundamental-mode))))))
          (hermes--promise-resolve request (hermes-files-test--read))
          (when (buffer-live-p viewer)
            (with-current-buffer viewer
              (should-not hermes-files--bytes)
              (should (string-empty-p (buffer-string))))))))))

(ert-deftest hermes-files-refresh-preserves-real-windows-and-typing ()
  (dolist (visibility '(selected unselected hidden))
    (hermes-files-test--with-api
      (hermes-files)
      (push (current-buffer) buffers)
      (hermes--promise-resolve (nth 3 (car calls)) (hermes-files-test--listing 100))
      (goto-char (point-min))
      (forward-line 40)
      (let* ((browser (current-buffer))
             (first (selected-window))
             (second (split-window-below))
             (other (generate-new-buffer " *typing*")))
        (push other buffers)
        (set-window-buffer second browser)
        (set-window-start first (save-excursion (forward-line -10) (point)) t)
        (set-window-start second (save-excursion (forward-line -20) (point)) t)
        (set-window-point second (save-excursion (forward-line 5) (point)))
        (hermes-files-refresh)
        (pcase visibility
          ('unselected (select-window second) (switch-to-buffer other))
          ('hidden (set-window-buffer first other)
                   (select-window second) (switch-to-buffer other)))
        (when (eq (current-buffer) other) (insert "draft stays"))
        (let ((window (selected-window)) (buffer (current-buffer)) (position (point))
              (starts (mapcar (lambda (w) (list w (window-start w) (window-point w)))
                              (get-buffer-window-list browser nil t))))
          (hermes--promise-resolve (nth 3 (car calls)) (hermes-files-test--listing 100))
          (should (eq window (selected-window)))
          (should (eq buffer (current-buffer)))
          (should (= position (point)))
          (pcase-dolist (`(,w ,start ,point) starts)
            (should (= start (window-start w)))
            (should (= point (window-point w)))))))))

(ert-deftest hermes-files-save-exact-bytes-and-refuse-unsafe-destinations ()
  (let ((directory (make-temp-file "hermes-files-" t))
        (bytes (unibyte-string 0 255 65 13 10)))
    (unwind-protect
        (with-temp-buffer
          (hermes-file-view-mode)
          (setq hermes-files--bytes bytes)
          (let ((path (expand-file-name "literal.gz" directory)))
            (hermes-file-save path)
            (with-temp-buffer
              (set-buffer-multibyte nil)
              (insert-file-contents-literally path)
              (should (equal (buffer-string) bytes)))
            (should-error (hermes-file-save path) :type 'user-error))
          (make-symbolic-link directory (expand-file-name "link" directory))
          (should-error (hermes-file-save (expand-file-name "link/new" directory))
                        :type 'user-error)
          (make-symbolic-link "absent" (expand-file-name "dangling" directory))
          (should-error (hermes-file-save (expand-file-name "dangling" directory))
                        :type 'user-error)
          (should-error (hermes-file-save "/ssh:remote:/new") :type 'user-error)
          (cl-letf (((symbol-function 'read-file-name)
                     (lambda (&rest _) (setq hermes-files--bytes "replacement")
                       (expand-file-name "changed" directory))))
            (should-error (call-interactively #'hermes-file-save) :type 'user-error)
            (should-not (file-exists-p (expand-file-name "changed" directory)))))
      (delete-directory directory t))))

(ert-deftest hermes-files-decode-validates-size-path-cap-and-base64 ()
  (should (equal (hermes-files--decode (hermes-files-test--read) "/remote/file0.el")
                 (unibyte-string 0 255 65)))
  (dolist (result '((:path "/other" :size 3 :data_url "data:x;base64,AP9B")
                    (:path "/remote/file0.el" :size 2 :data_url "data:x;base64,AP9B")
                    (:path "/remote/file0.el" :size 4194305 :data_url "data:x;base64,")
                    (:path "/remote/file0.el" :size 0 :data_url "file:/tmp/evil")
                    (:path "/remote/file0.el" :size 1 :data_url "data:x;base64,QQ===")
                    (:path "/remote/file0.el" :size 1 :data_url "data:x;base64,Q@==")))
    (should-error (hermes-files--decode result "/remote/file0.el"))))

