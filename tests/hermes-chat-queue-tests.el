  (let ((literal (concat (make-string 100 ?a) "\nexact steer tail"))
        callbacks recovery)
    (cl-letf (((symbol-function 'hermes-dashboard-transport-session-steer)
               (lambda (_client text &rest args)
                 (should (equal text literal)) (push args callbacks)))
              ((symbol-function 'display-buffer) #'ignore))
      (unwind-protect
          (hermes-test-with-dashboard-prompt-session (client)
            (funcall (hermes-chat--submit-resolve-callback
                      (current-buffer) hermes-chat--unsettled-submit-context)
                     '((status . "streaming")))
            (dotimes (_ 2)
              (insert literal)
              (call-interactively #'hermes-chat-steer-message))
            (hermes-chat-disconnect)
            (setq recovery hermes-chat--recovery-buffer)
            (should (buffer-live-p recovery))
            (let ((snapshot (with-current-buffer recovery (buffer-string))))
              (should (= 2 (with-temp-buffer
                             (insert snapshot) (goto-char (point-min))
                             (let ((count 0))
                               (while (search-forward literal nil t) (cl-incf count)) count))))
              (should (string-match-p "Delivery uncertain" snapshot))
              (funcall (plist-get (car callbacks) :reject) "late rejection")
              (funcall (plist-get (cadr callbacks) :resolve) '((status . "accepted")))
              (hermes-chat--capture-recovery)
              (should (equal snapshot (with-current-buffer recovery (buffer-string))))
              (should-not hermes-chat--queued-messages)))
        (when (buffer-live-p recovery) (kill-buffer recovery))))))

(ert-deftest hermes-chat-interim-interrupt-rejection-replays-one-turn ()
  (hermes-test-with-dashboard-prompt-session (client)
    (funcall (hermes-chat--submit-resolve-callback
              (current-buffer) hermes-chat--unsettled-submit-context)
             '((status . "streaming")))
    (let (reject submits)
      (cl-letf (((symbol-function 'hermes-dashboard-transport-session-interrupt)
                 (lambda (_client &rest args) (setq reject (plist-get args :reject))))
                ((symbol-function 'hermes-dashboard-transport-prompt-submit)
                 (lambda (_client text &rest args)
                   (push text submits)
                   (funcall (plist-get args :resolve) '((status . "streaming"))))))
        (hermes-chat-interrupt-and-send "successor")
        (hermes-test--emit-dashboard-prompt client "message.interim"
          '((text . "interim reply")))
        (hermes-test--emit-dashboard-prompt client "message.delta" '((text . "final reply")))
        (hermes-test--emit-dashboard-prompt client "message.complete"
          '((text . "final reply") (status . "complete")))
        ;; Trailing frames buffered after the terminal must not reach the successor.
        (hermes-test--emit-dashboard-prompt client "message.delta" '((text . "old trailer")))
        (funcall reject "not interrupted")
        (should (equal submits '("successor")))
        (should (equal (mapcar (lambda (entry) (plist-get entry :content))
                              (seq-filter (lambda (entry) (eq (plist-get entry :role) 'assistant))
                                          (hermes-chat--entries)))
                       '("interim reply" "final reply" "")))
        (funcall reject "duplicate")
        (should (equal submits '("successor")))))))

(ert-deftest hermes-chat-interim-interrupt-terminal-orders-stay-frozen ()
  (dolist (terminal-first '(t nil))
    (hermes-test-with-dashboard-prompt-session (client)
      (funcall (hermes-chat--submit-resolve-callback
                (current-buffer) hermes-chat--unsettled-submit-context)
               '((status . "streaming")))
      (let (resolve submits)
        (cl-letf (((symbol-function 'hermes-dashboard-transport-session-interrupt)
                   (lambda (_client &rest args) (setq resolve (plist-get args :resolve))))
                  ((symbol-function 'hermes-dashboard-transport-prompt-submit)
                   (lambda (_client text &rest args)
                     (push text submits)
                     (funcall (plist-get args :resolve) '((status . "streaming"))))))
          (hermes-test--emit-dashboard-prompt client "message.delta" '((text . "frozen")))
          (hermes-chat-interrupt-and-send "next")
          (hermes-test--emit-dashboard-prompt client "message.interim" '((text . "hidden")))
          (unless terminal-first (funcall resolve '((status . "interrupted"))))
          (hermes-test--emit-dashboard-prompt client "message.complete"
            '((text . "hidden final") (status . "interrupted")))
          (when terminal-first (funcall resolve '((status . "interrupted"))))
          (should (equal submits '("next")))
          (should (equal (mapcar (lambda (entry) (plist-get entry :content))
                                (seq-filter (lambda (entry) (eq (plist-get entry :role) 'assistant))
                                            (hermes-chat--entries)))
                         '("frozen" ""))))))))

(ert-deftest hermes-chat-steer-settlement-retires-only-its-occurrence ()
  (hermes-test-with-dashboard-prompt-session (client)
    (let (requests)
      (cl-letf (((symbol-function 'hermes-dashboard-transport-session-steer)
                 (lambda (_client _text &rest args) (push args requests))))
        (hermes-chat-steer-message "accepted")
        (hermes-chat-steer-message "rejected")
        (funcall (plist-get (cadr requests) :resolve) '((status . "accepted")))
        (should (equal (mapcar (lambda (record) (nth 2 record))
                              (seq-filter (lambda (record) (memq (car record) hermes-chat--pending-steers))
                                          (hermes-chat--recovery-records)))
                       '("rejected")))
        (funcall (plist-get (car requests) :resolve) '((status . "rejected")))
        (should-not hermes-chat--pending-steers)
        (should (equal (hermes-test--queued-contents) '("rejected")))
        (funcall (plist-get (car requests) :reject) "duplicate")
        (should (equal (hermes-test--queued-contents) '("rejected")))))))

(ert-deftest hermes-chat-queue-refresh-keeps-action-targets ()
  "Append, repeated moves and deletion keep stable IDs in both panel windows."
  (save-window-excursion
    (let ((owner (generate-new-buffer " *queue reader owner*"))
          panel)
      (unwind-protect
          (let (ids)
            (with-current-buffer owner
              (hermes-chat-mode)
              (dolist (text '("first" "second" "third" "fourth"))
                (hermes-chat--queue-content text))
              (setq ids (mapcar (lambda (e) (plist-get e :id))
                               hermes-chat--queued-messages)
                    panel (hermes-chat-queue-panel)))
            (switch-to-buffer panel)
            (delete-other-windows)
            (hermes-chat-queue-panel-refresh)
            (goto-char (point-min)) (forward-line 3)
            (let ((first (selected-window)) (second (split-window-right)))
              (set-window-point second
                                (save-excursion (forward-line 1) (point)))
              (with-current-buffer owner (hermes-chat--queue-content "fifth"))
              (should (equal (hermes-chat--queue-panel-entry-id) (nth 1 ids)))
              (dotimes (_ 2)
                (call-interactively (key-binding (kbd "d")))
                (should (equal (hermes-chat--queue-panel-entry-id) (nth 1 ids))))
              (dotimes (_ 2)
                (call-interactively (key-binding (kbd "u")))
                (should (equal (hermes-chat--queue-panel-entry-id) (nth 1 ids))))
              (call-interactively (key-binding (kbd "D")))
              (should (equal (hermes-chat--queue-panel-entry-id) (nth 2 ids)))
              (should (equal (get-text-property (window-point second)
                                                'hermes-chat-queue-id)
                             (nth 2 ids)))
              (should (eq first (selected-window)))
              (should (equal (with-current-buffer owner
                               (mapcar (lambda (e) (plist-get e :content))
                                       hermes-chat--queued-messages))
                             '("first" "third" "fourth" "fifth")))))
        (kill-buffer panel)
        (kill-buffer owner)))))

(ert-deftest hermes-chat-queue-reader-viewports-and-acceptance ()
  "Both queue windows retain identities and a removed last row falls back."
  (save-window-excursion
    (let ((owner (generate-new-buffer " *queue viewport owner*"))
          panel)
      (unwind-protect
          (let (ids)
            (with-current-buffer owner
              (hermes-chat-mode)
              (dotimes (n 80) (hermes-chat--queue-content (format "Item %02d" n)))
              (setq ids (mapcar (lambda (e) (plist-get e :id))
                               hermes-chat--queued-messages)
                    panel (hermes-chat-queue-panel)))
            (switch-to-buffer panel) (delete-other-windows)
            (hermes-chat-queue-panel-refresh)
            (let* ((first (selected-window)) (second (split-window-right))
                   (row (lambda (n) (text-property-any
                                     (point-min) (point-max)
                                     'hermes-chat-queue-id (nth n ids))))
                   (observe (lambda (window)
                              (mapcar (lambda (pos)
                                        (get-text-property pos 'hermes-chat-queue-id))
                                      (list (window-start window) (window-point window))))))
              (set-window-start first (funcall row 10) t)
              (set-window-point first (funcall row 12))
              (set-window-start second (funcall row 40) t)
              (set-window-point second (funcall row 42))
              (redisplay t)
              (let ((before (mapcar observe (list first second))))
                (with-current-buffer owner
                  (hermes-chat--queue-content "Last")
                  (setq hermes-chat--queued-submit-id (car ids))
                  (hermes-chat--queue-submit-accepted (car ids)))
                (redisplay t)
                (should (equal (mapcar observe (list first second)) before)))
              (goto-char (point-max)) (forward-line -1)
              (call-interactively (key-binding (kbd "D")))
              (should (equal (hermes-chat--queue-panel-entry-id) (car (last ids))))
              (should (equal (get-text-property (window-point second) 'hermes-chat-queue-id)
                             (nth 42 ids)))))
        (kill-buffer panel) (kill-buffer owner)))))

