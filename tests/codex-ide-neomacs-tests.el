(ert-deftest codex-ide-neomacs-native-title-preserves-session-label ()
  (codex-ide-neomacs-tests--with-host
    (let* ((session (codex-ide-neomacs-tests--start))
           (buffer (plist-get session :buffer))
           (id (plist-get (plist-get session :process) :id)))
      (dolist (label '("" "review" ""))
        (codex-ide--set-session-label session label)
        (let ((name (buffer-name buffer)))
          ;; Simulate the earlier native handler's OSC rename.
          (with-current-buffer buffer (rename-buffer " *native OSC title*" t))
          (run-hook-with-args 'neo-term-title-changed-functions id "title")
          (should (equal name (buffer-name buffer)))))
      (kill-buffer buffer)
      (should-not neo-term-title-changed-functions))))

