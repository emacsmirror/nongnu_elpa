(ert-deftest codex-ide-neomacs-config-preflight-fails-closed ()
  (let (codex-ide-mcp-neo--config-cache)
   (cl-letf (((symbol-function 'executable-find) (lambda (_) "/relay"))
            ((symbol-function 'call-process) (lambda (&rest _) 1)))
    (should-error (codex-ide-mcp-neo--config-overrides "/exact/socket")
                  :type 'user-error))))

(ert-deftest codex-ide-neomacs-install-confirmation-discloses-policy-loss ()
  (codex-ide-neomacs-tests--let (prompt logged ran)
    (cl-letf (((symbol-function 'codex-ide-mcp-ensure-server)
               (lambda () "/exact/socket"))
              ((symbol-function 'executable-find) (lambda (_) "/relay"))
              ((symbol-function 'codex-ide-log)
               (lambda (format-string &rest args)
                 (push (apply #'format format-string args) logged)))
              ((symbol-function 'y-or-n-p)
               (lambda (question) (setq prompt question) nil))
              ((symbol-function 'codex-ide-mcp--run-install-command)
               (lambda (_) (setq ran t))))
      (codex-ide-mcp-install-codex-config))
    (dolist (field '("replace" "enabled" "enabled_tools" "disabled_tools"))
      (should (string-match-p field prompt))
      (should (string-match-p field (string-join logged "\n"))))
    (should-not ran)))

(ert-deftest codex-ide-neomacs-optional-eat-missing-is-actionable ()
  (let ((original (symbol-function 'require))
        (codex-ide-terminal-backend 'eat)
        (name " *codex-ide-missing-eat*"))
    (cl-letf (((symbol-function 'require)
               (lambda (feature &optional filename noerror)
                 (unless (eq feature 'eat)
                   (funcall original feature filename noerror)))))
      (should-not (codex-ide-term-eat--available-p))
      (let ((err (should-error
                  (codex-ide-term--prepare-buffer name temporary-file-directory)
                  :type 'user-error)))
        (should (string-match-p "Install Eat" (error-message-string err))))
      (should-not (get-buffer name)))))

(ert-deftest codex-ide-neomacs-optional-eat-load-error-is-preserved ()
  (let ((original (symbol-function 'require))
        (condition '(file-missing "Eat dependency failed" "fixture-library")))
    (cl-letf (((symbol-function 'require)
               (lambda (feature &optional filename noerror)
                 (if (eq feature 'eat)
                     (signal (car condition) (cdr condition))
                   (funcall original feature filename noerror)))))
      (should (equal (should-error (codex-ide-term--load-backend 'eat)
                                  :type 'file-missing)
                     condition)))))


(ert-deftest codex-ide-neomacs-preflight-cache-identities ()
  "Preflight caches empty results and invalidates each configuration identity."
  (let* ((root (make-temp-file "native-cache-" t))
         (default-directory (file-name-as-directory root))
         (process-environment (copy-sequence process-environment))
         (codex-ide-cli-path "codex")
         (codex-ide-mcp-neo--config-cache nil)
         (calls 0) (mtime '(0 0 0 0)))
    (unwind-protect
        (progn
          (setenv "CODEX_HOME" (expand-file-name "codex-home" root))
          (cl-letf (((symbol-function 'call-process)
                     (lambda (&rest _) (cl-incf calls) (insert "[]") 0))
                    ((symbol-function 'file-attributes)
                     (lambda (_) (list nil nil nil nil nil mtime))))
            (dotimes (_ 2) (should-not (codex-ide-mcp-neo--configured-servers nil)))
            (should (= calls 1))
            (let ((codex-ide-cli-path "other"))
              (codex-ide-mcp-neo--configured-servers nil))
            (should (= calls 2))
            (let ((default-directory (file-name-as-directory (expand-file-name "other" root))))
              (codex-ide-mcp-neo--configured-servers nil))
            (should (= calls 3))
            (codex-ide-mcp-neo--configured-servers '(("model" . "x")))
            (should (= calls 4))
            (setq mtime '(0 1 0 0))
            (codex-ide-mcp-neo--configured-servers '(("model" . "x")))
            (should (= calls 5))))
      (delete-directory root t))))

