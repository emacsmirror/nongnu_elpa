(ert-deftest codex-ide-neomacs-mcp-exact-native-endpoint ()
  (codex-ide-neomacs-tests--let (
				 (neomacs-mcp--socket "/private/socket with space")
				 (listener (make-pipe-process :name "native listener fixture" :noquery t)))
				(unwind-protect
				    (let ((neomacs-mcp--listener listener))
				      (cl-letf (((symbol-function 'require) (lambda (&rest _) t))
						((symbol-function 'process-contact) (lambda (&rest _) "/private/socket with space")))
					(should (equal (codex-ide-mcp-neo--socket) neomacs-mcp--socket)))
				      (cl-letf (((symbol-function 'require) (lambda (&rest _) t))
						((symbol-function 'process-contact) (lambda (&rest _) "/different/socket")))
					(should-not (codex-ide-mcp-neo--socket))))
				  (delete-process listener))))

(ert-deftest codex-ide-neomacs-mcp-overrides-and-disable ()
  (codex-ide-neomacs-tests--let (
				 (codex-ide-config-overrides '(("model" . "\"test\"")))
				 (codex-ide-mcp-enabled t))
				(cl-letf (((symbol-function 'codex-ide-mcp-neo--socket) (lambda () "/exact/α socket"))
					  ((symbol-function 'call-process)
                                           (lambda (&rest _) (insert "[]") 0))
					  ((symbol-function 'executable-find) (lambda (_) "/relay with space")))
				  (should (equal (codex-ide--session-config-overrides)
						 '(("model" . "\"test\"")
						   ("mcp_servers.neomacs.command" . "\"/relay with space\"")
						   ("mcp_servers.neomacs.args" . "[\"--socket\", \"/exact/α socket\"]"))))
				  (should (equal (codex-ide-mcp-neo--install-command-args "/exact/α socket")
						 '("codex" "mcp" "add" "neomacs" "--" "/relay with space" "--socket" "/exact/α socket")))
				  (let ((codex-ide-mcp-enabled nil))
				    (should (equal (codex-ide--session-config-overrides) codex-ide-config-overrides))))))

