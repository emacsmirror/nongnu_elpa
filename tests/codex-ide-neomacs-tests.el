(ert-deftest codex-ide-neomacs-recovery-idempotent-and-sibling-stop ()
  (codex-ide-neomacs-tests--with-host
   (let* ((first (codex-ide-neomacs-tests--start))
          (second (codex-ide-neomacs-tests--start))
          (hooks (copy-sequence neo-term-settled-functions)))
     (clrhash codex-ide--sessions)
     (codex-ide--recover-live-sessions)
     (codex-ide--recover-live-sessions)
     (should (= (length (codex-ide--raw-sessions)) 2))
     (should (equal hooks neo-term-settled-functions))
     (with-current-buffer (plist-get first :buffer) (codex-ide-stop))
     (should (codex-ide--session-live-p second))
     (should (equal destroyed '(1)))
     (should (= (length neo-term-settled-functions) 1)))))

(ert-deftest codex-ide-neomacs-completion-and-stale-callback ()
  (codex-ide-neomacs-tests--with-host
   (dolist (status '((0 nil t nil nil) (9 nil t nil nil) (nil "Hangup" t nil nil)
                     (0 nil nil nil nil) (0 nil t "wait failed" nil)
                     (0 nil t nil "read failed")))
     (let* ((session (codex-ide-neomacs-tests--start))
            (buffer (plist-get session :buffer))
            (resource (plist-get session :process))
            (id (plist-get resource :id))
            (callback (plist-get resource :settled)))
       ;; Native settlement clears its ID before invoking later hooks.
       (with-current-buffer buffer
         (remhash neo-term--id neo-term--terminals)
         (setq neo-term--id nil))
       ;; Earlier native settlement hooks can enumerate sessions.
       (should-not (codex-ide--all-sessions))
       (apply callback id status)
       (if (equal status '(0 nil t nil nil))
           (should-not (buffer-live-p buffer))
         (should (buffer-live-p buffer))
         (with-current-buffer buffer
           (should buffer-read-only)
           (should (string-match-p "Codex exited:" (buffer-string)))))
       (should-not (codex-ide--raw-sessions))
       (let ((successor (codex-ide-neomacs-tests--start)))
         (apply callback id status)
         (should (codex-ide--session-live-p successor))
         (with-current-buffer (plist-get successor :buffer) (codex-ide-stop)))))
   (should-not neo-term-settled-functions)
   (should-not neo-term-create-failed-functions)
   (should-not neo-term-exit-functions)))

(ert-deftest codex-ide-neomacs-kill-and-mode-change-cleanup ()
  (codex-ide-neomacs-tests--with-host
   (let ((session (codex-ide-neomacs-tests--start)))
     (kill-buffer (plist-get session :buffer))
     (should-not (codex-ide--raw-sessions)))
   (let* ((session (codex-ide-neomacs-tests--start))
          (buffer (plist-get session :buffer)))
     (with-current-buffer buffer (fundamental-mode))
     (should (buffer-live-p buffer))
     (should-not (codex-ide--raw-sessions)))
   (should (equal destroyed '(2 1)))
   (should-not neo-term-settled-functions)))

