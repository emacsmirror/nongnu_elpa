(ert-deftest codex-ide-neomacs-extra-config-refuses-before-terminal-creation ()
  (codex-ide-neomacs-tests--with-host
    (let ((codex-ide-mcp-enabled t)
          prepared)
      (cl-letf (((symbol-function 'codex-ide-mcp-neo--socket)
                 (lambda () "/exact/socket"))
                ((symbol-function 'codex-ide-mcp-neo--configured-servers)
                 (lambda (_) nil))
                ((symbol-function 'codex-ide-term--prepare-buffer)
                 (lambda (&rest _) (setq prepared t) (error "Terminal creation"))))
        (dolist (args '(("-p" "review") ("-preview") ("-p=review")
                        ("--profile" "review") ("--profile=review")
                        ("-c" "model=\"test\"") ("-cmodel=\"test\"")
                        ("-c=model=\"test\"") ("--config" "model=\"test\"")
                        ("--config=model=\"test\"")
                        ("-C" "/fixture") ("-C/fixture") ("-C=/fixture")
                        ("--cd" "/fixture") ("--cd=/fixture")
                        ("--remote" "unix:///fixture") ("--remote=unix:///fixture")
                        ("--remote-auth-token-env" "TOKEN")
                        ("--remote-auth-token-env=TOKEN")))
          (let* ((codex-ide-cli-extra-args args)
                 (err (should-error (codex-ide-new-session) :type 'user-error)))
            (should (string-match-p "codex-ide-config-overrides" (error-message-string err)))
            (should (string-match-p "codex-ide-mcp-enabled" (error-message-string err)))))
        (should-not prepared)
        (should-not launched)
        (should-not buffers)))))

