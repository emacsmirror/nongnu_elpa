;;; Commentary:

;; Exercise full registered sessions with a deterministic native host boundary.
;; The native batch lane also loads the installed neo-term and MCP libraries;
;; real GPU/PTY and Codex interoperability require interactive verification.

;;; Code:

(require 'ert)
(require 'cl-lib)
(require 'codex-ide)
(require 'codex-ide-term-eat)

(defmacro codex-ide-neomacs-tests--let (bindings &rest body)
  "Run BODY with BINDINGS and Neomacs feature detection enabled."
  (declare (indent 1) (debug (sexp body)))
  `(let ((native-feature-p (symbol-function 'featurep)))
     (cl-letf (((symbol-function 'featurep)
                (lambda (feature &optional subfeature)
                  (or (and (eq feature 'neomacs) (null subfeature))
                      (funcall native-feature-p feature subfeature)))))
       (let ,bindings ,@body))))

(declare-function neo-term-mode "neo-term" ())

(defvar neo-term--id)
(defvar neo-term--terminals)
(defvar neo-term-settled-functions)
(defvar neo-term-create-failed-functions)
(defvar neo-term-exit-functions)
(defvar neo-term-title-changed-functions)
(defvar neomacs-mcp--listener)
(defvar neomacs-mcp--socket)

(defmacro codex-ide-neomacs-tests--with-host (&rest body)
  "Run BODY with isolated sessions and a deterministic native host."
  (declare (indent 0) (debug t))
  `(codex-ide-neomacs-tests--let (
				  (neo-term--terminals (make-hash-table :test #'eql))
				  (neo-term-settled-functions nil)
				  (neo-term-create-failed-functions nil)
				  (neo-term-exit-functions nil)
				  (neo-term-title-changed-functions nil)
				  (codex-ide--sessions (make-hash-table :test #'equal))
				  (codex-ide--active-session-ids (make-hash-table :test #'equal))
				  (codex-ide-terminal-backend 'neo-term)
				  (codex-ide-mcp-enabled nil)
				  (codex-ide-context-auto-start nil)
				  (default-directory temporary-file-directory)
				  (next-id 0) sent destroyed launched buffers)
				 (cl-letf (((symbol-function 'codex-ide--ensure-cli) (lambda () t))
					   ((symbol-function 'codex-ide--get-working-directory)
					    (lambda () temporary-file-directory))
					   ((symbol-function 'codex-ide--record-source-buffer) #'ignore)
					   ((symbol-function 'codex-ide-term-neo--available-p) (lambda () t))
					   ((symbol-function 'executable-find) (lambda (program) (concat "/bin/" program)))
					   ((symbol-function 'codex-ide--display-buffer)
					    (lambda (buffer &optional _select) (set-window-buffer (selected-window) buffer) (selected-window)))
					   ((symbol-function 'neo-term-exec)
					    (lambda (program args directory environment &optional _origin)
					      (push (list program args directory environment) launched)
					      (let ((buffer (generate-new-buffer " *native test*")))
						(push buffer buffers)
						(with-current-buffer buffer
						  (if (fboundp 'neo-term-mode)
						      (neo-term-mode)
						    (fundamental-mode)
						    (setq-local major-mode 'neo-term-mode))
						  (setq-local default-directory directory)
						  (setq-local neo-term--id (cl-incf next-id))
						  (puthash neo-term--id (list :buffer buffer) neo-term--terminals))
						buffer)))
					   ((symbol-function 'neo-term--write)
					    (lambda (id text) (push (cons id text) sent)))
					   ((symbol-function 'neo-term--kill-buffer-terminal)
					    (lambda ()
					      (when neo-term--id
						(push neo-term--id destroyed)
						(remhash neo-term--id neo-term--terminals)
						(setq neo-term--id nil))))
					   ((symbol-function 'sit-for) (lambda (&rest _) t)))
				   (unwind-protect
				       (progn ,@body)
				     (mapc (lambda (buffer)
					     (when (buffer-live-p buffer) (kill-buffer buffer))) buffers)
				     (mapc (lambda (session)
					     (let ((buffer (plist-get session :buffer)))
					       (when (buffer-live-p buffer) (kill-buffer buffer))))
					   (codex-ide--raw-sessions))))))

(defun codex-ide-neomacs-tests--start ()
  "Start and return a fully registered native test session."
  (codex-ide-new-session)
  (codex-ide--session-by-id temporary-file-directory
                            (gethash temporary-file-directory codex-ide--active-session-ids)))

(ert-deftest codex-ide-neomacs-default-selection-and-customization ()
  (codex-ide-neomacs-tests--let (
				 (codex-ide-terminal-backend 'eat)
				 (customized (get 'codex-ide-terminal-backend 'customized-value))
				 (saved (get 'codex-ide-terminal-backend 'saved-value)))
				(unwind-protect
				    (progn
				      (put 'codex-ide-terminal-backend 'customized-value nil)
				      (put 'codex-ide-terminal-backend 'saved-value nil)
				      (should (eq (codex-ide-term--selected-backend) 'neo-term))
				      (put 'codex-ide-terminal-backend 'customized-value '(eat))
				      (should (eq (codex-ide-term--selected-backend) 'eat))
				      (put 'codex-ide-terminal-backend 'customized-value nil)
				      (put 'codex-ide-terminal-backend 'saved-value '(eat))
				      (should (eq (codex-ide-term--selected-backend) 'eat))
				      (let ((codex-ide-terminal-backend 'vterm))
					(should (eq (codex-ide-term--selected-backend) 'vterm))))
				  (put 'codex-ide-terminal-backend 'customized-value customized)
				  (put 'codex-ide-terminal-backend 'saved-value saved))))

(ert-deftest codex-ide-neomacs-context-auto-start-skips-legacy-server ()
  (codex-ide-neomacs-tests--with-host
    (let ((codex-ide-context-auto-start t)
          mode-calls server-calls)
      (cl-letf (((symbol-function 'codex-ide-context-mode)
                 (lambda (&rest args) (push args mode-calls)))
                ((symbol-function 'codex-ide-context--start-server)
                 (lambda () (push t server-calls))))
        (let ((session (codex-ide-neomacs-tests--start)))
          (should (codex-ide--session-live-p session))
          (should (= (length (codex-ide--raw-sessions)) 1))
          (should (= (length launched) 1))))
      (should-not mode-calls)
      (should-not server-calls))))

(ert-deftest codex-ide-neomacs-context-auto-start-retains-gnu-behavior ()
  (let ((native-feature-p (symbol-function 'featurep))
        calls)
    (cl-letf (((symbol-function 'featurep)
               (lambda (feature &optional subfeature)
                 (and (not (eq feature 'neomacs))
                      (funcall native-feature-p feature subfeature))))
              ((symbol-function 'codex-ide-context-mode)
               (lambda (&rest args) (push args calls))))
      (let ((codex-ide-context-auto-start nil))
        (codex-ide--maybe-ensure-context-server)
        (should-not calls))
      (let ((codex-ide-context-auto-start t))
        (codex-ide--maybe-ensure-context-server)
        (should (equal calls '((1))))))))

(ert-deftest codex-ide-neomacs-exact-argv-environment ()
  (codex-ide-neomacs-tests--with-host
   (let ((codex-ide-cli-extra-args '("argument with space" "α\nβ" "$HOME")))
     (let* ((session (codex-ide-neomacs-tests--start))
            (resource (plist-get session :process)))
       (should-not (processp resource))
       (should (codex-ide--session-live-p session))
       (should (equal (caar launched) "/bin/codex"))
       (should (equal (cadar launched) codex-ide-cli-extra-args))
       (should (equal (nth 2 (car launched)) temporary-file-directory))
       (should (equal (car (nth 3 (car launched))) "TERM_PROGRAM=emacs"))
       (should (equal (plist-get resource :command) (cons "codex" codex-ide-cli-extra-args)))))))

