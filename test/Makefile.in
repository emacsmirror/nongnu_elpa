@SET_MAKE@

##############################################################################
# VM Test Suite Makefile
##############################################################################
#
# The tests are run by ./test-runner, not from here: it probes what this
# machine has -- live servers, a sending config, the optional packages -- and
# runs a pass for each, saying what it left out and why.  This file forwards to
# it, so that one place decides what a test run is.
#
#   make test                                every pass this machine can run
#   make test ARGS="--one vm-imap-test.el"   one file
#   make test ARGS=--probe                   what is available, run nothing
#   ./test-runner --help                     the rest of the options
##############################################################################

SHELL = /bin/sh
EMACS_PROG = @EMACS_PROG@
srcdir = @srcdir@
top_srcdir = @top_srcdir@

ARGS =

# Records that the optional packages have been fetched.  A stamp rather than
# the packages themselves: those land in directories whose names carry a
# version, which no rule can name in advance.
OPTIONAL_STAMP = $(srcdir)/opt/installed

.PHONY: test optional-packages clean distclean

# Everything this machine can run.  ARGS goes to the runner: --one FILE,
# --imap, --pop, --send, --mock, --no-optional, --assert, --leaks, --coverage,
# --skip-live, --skip-send, --verbose, --probe.
#
# The optional packages are fetched first, so that a run covers as much as the
# machine can rather than skipping whatever nobody remembered to install.
test: $(OPTIONAL_STAMP)
	EMACS=$(EMACS_PROG) $(srcdir)/test-runner $(ARGS)

optional-packages: $(OPTIONAL_STAMP)

# Fetch the packages VM integrates with but does not require -- BBDB,
# emacs-w3m, vcard -- into test/opt/elpa, where vm-test-init.el finds them and
# the tests that need one stop skipping.  With them installed a run also has a
# pass without them, which is how an ordinary checkout runs those tests.
#
# This is the only part of the tests that needs the network, and a failure is
# not fatal: a missing companion is the state the tests are written to
# tolerate, so it warns, stamps, and lets them skip.  To try again, remove the
# stamp.  Nothing here is committed: test/opt is ignored.
$(OPTIONAL_STAMP):
	-$(EMACS_PROG) -batch -Q -l $(srcdir)/install-optional-packages.el \
		-f vm-optional-install-batch $(srcdir)/opt
	@mkdir -p $(srcdir)/opt
	@touch $@
	@if [ ! -d $(srcdir)/opt/elpa ]; then \
	  echo "Warning: no optional packages; the tests that use one will skip."; \
	  echo "         To try again: rm $(OPTIONAL_STAMP)"; \
	fi

# Clean test artifacts
clean:
	-rm -f $(srcdir)/coverage-results.txt
	@# What VM itself writes during a run: the IMAP cache of any folder the
	@# live tests visit.  In the tree so that this can remove it -- it used
	@# to go to $$HOME, there being no other default.
	-rm -rf $(srcdir)/scratch

distclean: clean
	@# The optional packages `make optional-packages' downloads -- bbdb,
	@# emacs-w3m, vcard.  Not in `clean': they take the network to fetch,
	@# and a `clean' that leaves the tests skipping until someone notices
	@# is a poor trade.  They are not part of the checkout, so `distclean'
	@# is where they go.
	-rm -rf $(srcdir)/opt/elpa
	-rm -f $(OPTIONAL_STAMP)
	-rmdir $(srcdir)/opt 2> /dev/null || true
	-rm -f Makefile
