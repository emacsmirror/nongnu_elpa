(require 'ert)
(require 'markdown-ts-appear)
(require 'markdown-ts-appear-mathjax)

(defconst appear-mj--svg "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"30pt\" height=\"12pt\" viewBox=\"0 -900 3000 1200\"><path d=\"M0 0L1000 0\" stroke=\"currentColor\"/></svg>")
(defconst appear-mj--entry (list :svg appear-mj--svg :width 30 :ex 4.42 :ascent 75))

(defmacro appear-mj--buffer (text &rest body)
  "Evaluate BODY in a controlled-renderer Markdown buffer containing TEXT."
  (declare (indent 1))
  `(progn
     (skip-unless (and (treesit-ready-p '(markdown markdown-inline))
                       (require 'mathjax nil t) (mathjax-available-p)))
     (save-window-excursion
       (with-temp-buffer
         (switch-to-buffer (current-buffer))
         (insert ,text)
         (markdown-ts-mode)
         (setq-local markdown-ts-appear-enable-math-preview t
                     markdown-ts-appear-math-renderer 'mathjax)
         (goto-char (point-max))
         (cl-letf (((symbol-function 'display-images-p) (lambda (&rest _) t))
                   ((symbol-function 'markdown-ts-appear-mathjax--image)
                    (lambda (_ov entry) (and (plist-get entry :svg)
                                             (list 'image :type 'svg :data (plist-get entry :svg)
                                                   :width 30 :ascent 'center))))
                   ((symbol-function 'markdown-ts-appear-mathjax-render)
                    (lambda (&rest _) appear-mj--entry)))
           (unwind-protect
               (progn (markdown-ts-appear-mode 1) ,@body)
             (markdown-ts-appear-mode -1)))))))

(defun appear-mj--wait (predicate)
  "Wait for PREDICATE while handling worker output."
  (let ((deadline (+ (float-time) 15)))
    (while (and (not (funcall predicate)) (< (float-time) deadline))
      (accept-process-output nil 0.01))
    (should (funcall predicate))))

(ert-deftest appear-mj-detection-code-delimiters-and-comments ()
  (with-temp-buffer
    (insert "Before $x$ and \\(y\\).\n\n$$\nx % $$ in a comment\n+y\n$$\n\n\\[z\\]\n\n\\begin{equation}a=1\\tag{1}\\end{equation}\n\n"
            "`$inline-code$` and \\$escaped\n\n```tex\n$block-code$\n```\n\n    $indented$\n\n"
            "| A | B |\n|---|---|\n| `$code$` | $table$ |\n")
    (markdown-ts-mode)
    (let ((records (markdown-ts-appear-mathjax--scan (point-min) (point-max))))
      (should (= 6 (length records)))
      (should (equal (mapcar #'car records) '(inline inline display display environment inline)))
      (should (equal (nth 3 (car (last records))) "table")))))

(ert-deftest appear-mj-source-only-and-render-on-leave ()
  (appear-mj--buffer "Before\n\n$$\nx^2\n$$\n\nAfter\n"
    (should markdown-ts-appear-mathjax-mode)
    (should-not (bound-and-true-p latex-to-svg-frontend-mode))
    (goto-char (point-min)) (search-forward "x^")
    (run-hooks 'post-command-hook)
    (let ((ov (markdown-ts-appear-mathjax--at-point)) (calls 0))
      (should-not (overlay-get ov 'display))
      (should-not (markdown-ts-appear-mathjax--preview-string ov))
      (cl-letf (((symbol-function 'markdown-ts-appear-mathjax-render)
                 (lambda (&rest _) (cl-incf calls) appear-mj--entry)))
        (insert "3") (run-hooks 'post-command-hook)
        (markdown-ts-appear-mathjax-refresh)
        (should (= 0 calls))
        (goto-char (point-max)) (run-hooks 'post-command-hook)
        (should (= 1 calls))
        (should (overlay-get ov 'display))
        (should (string-search "x^32" (overlay-get ov 'markdown-ts-appear-mathjax--source)))))))

(ert-deftest appear-mj-live-preview-retention-and-cleanup ()
  (let ((markdown-ts-appear-mathjax-edit-preview t))
    (appear-mj--buffer "Before\n\n$$\nx^2\n$$\n\nAfter\n"
      (goto-char (point-min)) (search-forward "x^")
      (run-hooks 'post-command-hook)
      (let* ((ov (markdown-ts-appear-mathjax--at-point))
             (view (markdown-ts-appear-mathjax--preview-string ov))
             (rows (overlay-get ov 'markdown-ts-appear-mathjax--rows))
             callback)
        (should view)
        (cl-letf (((symbol-function 'markdown-ts-appear-mathjax-render)
                   (lambda (_body _display ready) (setq callback ready) nil)))
          (insert "3") (run-hooks 'post-command-hook)
          (should (eq view (markdown-ts-appear-mathjax--preview-string ov)))
          (markdown-ts-appear-mathjax-refresh)
          (should callback)
          (should (eq rows (overlay-get ov 'markdown-ts-appear-mathjax--rows)))
          (funcall callback (list :error "Invalid command"))
          (should-not (overlay-get ov 'markdown-ts-appear-mathjax--image))
          (should (string-search "Invalid command" (markdown-ts-appear-mathjax--preview-string ov)))
          (markdown-ts-appear-stop) (run-hooks 'post-command-hook)
          (should-not (markdown-ts-appear-mathjax--preview-string ov))
          (markdown-ts-appear-mode -1)
          (funcall callback appear-mj--entry)
          (should-not (overlay-buffer ov))
          (should-not (seq-some #'overlay-buffer rows)))))))

(ert-deftest appear-mj-stale-results-and-zero-motion-requests ()
  (appear-mj--buffer "Before $x$ after\n"
    (goto-char (point-min)) (search-forward "$x")
    (run-hooks 'post-command-hook)
    (let ((ov (markdown-ts-appear-mathjax--at-point)) callback (calls 0))
      (cl-letf (((symbol-function 'markdown-ts-appear-mathjax-render)
                 (lambda (_body _display ready) (cl-incf calls) (setq callback ready) nil)))
        (insert "y") (run-hooks 'post-command-hook)
        (goto-char (point-max)) (run-hooks 'post-command-hook)
        (should callback)
        (goto-char (point-min)) (search-forward "$xy")
        (insert "z") (run-hooks 'post-command-hook)
        (funcall callback appear-mj--entry)
        (should-not (overlay-get ov 'display))
        (setq calls 0)
        (dotimes (_ 100) (run-hooks 'post-command-hook))
        (should (= 0 calls))))))

(ert-deftest appear-mj-real-worker-cache-isolation-and-failure ()
  (skip-unless (and (require 'mathjax nil t) (mathjax-available-p)))
  (let ((markdown-ts-appear-mathjax-cache-directory (make-temp-file "independent-mathjax-" t))
        (markdown-ts-appear-mathjax--cache (make-hash-table :test #'equal))
        (markdown-ts-appear-mathjax--images (make-hash-table :test #'equal))
        (calls 0) results
        (send (symbol-function 'markdown-ts-appear-mathjax--send)))
    (unwind-protect
        (cl-letf (((symbol-function 'markdown-ts-appear-mathjax--send)
                   (lambda (&rest args) (cl-incf calls) (apply send args))))
          (dotimes (_ 2)
            (markdown-ts-appear-mathjax-render "\\frac{x}{2}" nil (lambda (entry) (push entry results))))
          (appear-mj--wait (lambda () (= 2 (length results))))
          (should (= 1 calls))
          (should (plist-get (car results) :svg))
          (should (markdown-ts-appear-mathjax-render "\\frac{x}{2}" nil #'ignore))
          (should (= 1 calls))
          (clrhash markdown-ts-appear-mathjax--cache)
          (should (markdown-ts-appear-mathjax-render "\\frac{x}{2}" nil #'ignore))
          (should (= 1 calls))
          (dolist (case '(("\\def\\OnlyHere{x}\\OnlyHere" t) ("\\OnlyHere" nil)
                          ("\\frac{" nil) ("x^2" t) ("\\begin{equation}x=1\\tag{1}\\end{equation}" t)))
            (setq results nil)
            (markdown-ts-appear-mathjax-render (car case) t (lambda (entry) (push entry results)))
            (appear-mj--wait (lambda () results))
            (if (cadr case) (should (plist-get (car results) :svg))
              (should (plist-get (car results) :error)))))
      (markdown-ts-appear-mathjax-stop)
      (delete-directory markdown-ts-appear-mathjax-cache-directory t))))

(ert-deftest appear-mj-table-images-and-no-latex-require ()
  (let ((require (symbol-function 'require)))
    (cl-letf (((symbol-function 'require)
               (lambda (feature &rest args)
                 (when (string-prefix-p "latex-to-svg" (symbol-name feature))
                   (ert-fail "MathJax attempted to load latex-to-svg"))
                 (apply require feature args))))
      (appear-mj--buffer "| A | B |\n|---|---|\n| x | $y$ |\n\nAfter\n"
        (markdown-ts-appear-stop)
        (font-lock-ensure)
        (markdown-ts-appear-table--post-command)
        (should (markdown-ts-appear-math--table-spans (point-min) (point-max)))
        (should (seq-some (lambda (ov) (overlay-get ov 'markdown-ts-appear-table--rich))
                          markdown-ts-appear-table--overlays))))))

(ert-deftest appear-mj-independent-ownership-and-clone ()
  (appear-mj--buffer "Before $x$ after\n"
    (markdown-ts-appear-mode -1)
    (markdown-ts-appear-mathjax-mode 1)
    (markdown-ts-appear-mode 1)
    (let* ((base (current-buffer))
           (ov (car markdown-ts-appear-mathjax--objects))
           (clone (clone-indirect-buffer " *mathjax-clone*" nil)))
      (unwind-protect
          (with-current-buffer clone
            (should markdown-ts-appear-mathjax-mode)
            (should-not markdown-ts-appear-mode)
            (should (eq (overlay-buffer ov) base))
            (should-not (memq ov markdown-ts-appear-mathjax--objects)))
        (kill-buffer clone))
      (markdown-ts-appear-mode -1)
      (should markdown-ts-appear-mathjax-mode)
      (should (overlay-buffer ov))
      (markdown-ts-appear-mathjax-mode -1)
      (should-not (overlay-buffer ov)))))

(ert-deftest appear-mj-switch-providers ()
  (skip-unless (require 'latex-to-svg-for-markdown nil t))
  (appear-mj--buffer "No formula needed for provider switching.\n"
    (setq-local markdown-ts-appear-math-renderer 'latex-to-svg)
    (markdown-ts-appear-math--restart)
    (should-not markdown-ts-appear-mathjax-mode)
    (should latex-to-svg-for-markdown-mode)
    (setq-local markdown-ts-appear-math-renderer 'mathjax)
    (markdown-ts-appear-math--restart)
    (should markdown-ts-appear-mathjax-mode)
    (should-not latex-to-svg-for-markdown-mode)
    (should-not latex-to-svg-frontend-mode)))

(ert-deftest appear-mj-gui-real-images-and-source-only ()
  (skip-unless (display-graphic-p))
  (let ((markdown-ts-appear-mathjax-cache-directory (make-temp-file "mathjax-gui-" t))
        (markdown-ts-appear-math-renderer 'mathjax)
        (markdown-ts-appear-enable-math-preview t)
        (markdown-ts-appear-mathjax-edit-preview nil))
    (unwind-protect
        (save-window-excursion
          (with-temp-buffer
            (switch-to-buffer (current-buffer))
            (insert "Before\n\n$$\n\\frac{x}{2}\n$$\n\n\\begin{equation}x=1\\tag{1}\\end{equation}\n\n| A | B |\n|---|---|\n| x | $y^2$ |\n\nAfter\n")
            (markdown-ts-mode)
            (goto-char (point-max))
            (markdown-ts-appear-mode 1)
            (appear-mj--wait
             (lambda () (and (= 3 (length markdown-ts-appear-mathjax--objects))
                             (seq-every-p (lambda (ov) (overlay-get ov 'display))
                                          markdown-ts-appear-mathjax--objects))))
            (dolist (ov markdown-ts-appear-mathjax--objects)
              (let* ((image (overlay-get ov 'display))
                     (size (image-size image t))
                     (color (apply #'format "#%02x%02x%02x"
                                   (mapcar (lambda (value) (/ value 257))
                                           (color-values (face-foreground 'markdown-ts-latex nil t))))))
                (should (> (car size) 0)) (should (> (cdr size) 0))
                (should (string-search color (image-property image :data)))))
            (goto-char (point-min)) (search-forward "frac")
            (run-hooks 'post-command-hook)
            (let ((ov (markdown-ts-appear-mathjax--at-point)))
              (should-not (overlay-get ov 'display))
              (should-not (markdown-ts-appear-mathjax--preview-string ov))
              (markdown-ts-appear-stop)
              (run-hooks 'post-command-hook)
              (should (overlay-get ov 'display)))
            (markdown-ts-appear-mode -1)))
      (markdown-ts-appear-mathjax-stop)
      (delete-directory markdown-ts-appear-mathjax-cache-directory t))))

(provide 'markdown-ts-appear-mathjax-independent-test)
