;;; vm-live-config.el --- Servers for the live tests -*- lexical-binding: t; -*-

;; This is a template.  Copy it and fill in your own hosts and passwords:
;;
;;     cp test/vm-live-config.el.template test/vm-live-config.el
;;
;; test/vm-live-config.el is gitignored, and must stay that way: it holds
;; passwords in the clear.  This template is checked in, so it must not.
;;
;; The file's presence is the opt-in for the live tests.  Without it every one
;; of them skips and a run never touches the network; with it they run, as part
;; of the default `test/test-runner' as well as `./test-runner --imap' and
;; `--pop'.
;; Bind `vm-imap-live-enabled' or `vm-pop-live-enabled' to nil to suppress
;; either half without deleting this file.
;;
;; Setting up the server side -- dovecot users, a certificate, pop3 in
;; protocols -- is in dev/docs/dev-guide.org under "testing".  The design notes
;; are in dev/docs/design/imap-live-tests.org.
;;
;; Two things bite:
;;
;;   - The :name values are load-bearing.  Tests ask for servers by name:
;;     "plain" and "tls" for IMAP, "pop" and "pop-tls" for POP.  A server
;;     under any other name is simply never used, and the tests that wanted
;;     it skip without saying why.
;;
;;   - A password cannot contain a colon.  VM's maildrop specifications are
;;     colon-delimited (imap:HOST:PORT:MAILBOX:AUTH:USER:PASSWORD and
;;     pop:HOST:PORT:AUTH:USER:PASSWORD) and cannot express one.
;;
;; Drop any server you have not set up: its tests then skip, which is not a
;; failure.  But a server that is listed and cannot be reached *is* a failure,
;; on purpose -- a suite that quietly skips a server it was told about has no
;; coverage.

;; Sending mail is configured separately, and is a pass of its own: see
;; `vm-send-test-config' at the end of this file.

;;; Code:

(setq vm-imap-test-servers
      '((:name     "plain"
	 :host     "127.0.0.1"
	 :port     143
	 :tls      nil
	 :auth     "login"
	 ;; Two accounts: the cross-account tests (#38, saving between
	 ;; folders) need a second one.  Single-account tests use the first.
	 :accounts (("vmtest1" . "PASSWORD1")
		    ("vmtest2" . "PASSWORD2")))
	(:name     "tls"
	 ;; Must match the certificate's subjectAltName, not merely its CN:
	 ;; GnuTLS ignores a bare CN, so "127.0.0.1" here with a certificate
	 ;; issued for "localhost" fails verification.
	 :host     "localhost"
	 :port     993
	 :tls      t
	 :auth     "login"
	 :trustfile "/opt/local/etc/dovecot/ssl/vmtest-cert.pem"
	 :accounts (("vmtest1" . "PASSWORD1")))))

;; POP.  Needs pop3 in dovecot's protocols; it ships with imap only, so
;; nothing listens on 110 until that is changed.  The live POP tests also use
;; the IMAP server named "plain", for the same account: POP3 has no APPEND, so
;; a fixture goes in over IMAP and is read back over POP.
(setq vm-pop-test-servers
      '((:name     "pop"
	 :host     "127.0.0.1"
	 :port     110
	 :tls      nil
	 ;; "pass" is USER/PASS; "apop" is the digest form.
	 :auth     "pass"
	 :accounts (("vmtest1" . "PASSWORD1")))
	(:name     "pop-tls"
	 :host     "localhost"		; the certificate's subjectAltName again
	 :port     995
	 :tls      t
	 :auth     "pass"
	 :trustfile "/opt/local/etc/dovecot/ssl/vmtest-cert.pem"
	 :accounts (("vmtest1" . "PASSWORD1")))))

;; The mail-sending tests, `./test-runner --send'.  These send real mail, so they run
;; only from that target and only with this set.  Leave it out and they skip.
;;
;; :to must be your own address.  The tests mark every message with an
;; `X-VM-Send-Test' header and delete it again, but mail that leaves the
;; machine cannot be recalled, so nothing here should ever name someone else.
;;
;; No password: how this machine sends mail is its own business.  Set
;; `send-mail-function' and whatever it needs below -- msmtp through
;; `sendmail-program', or smtpmail with auth-source, or anything else.  The
;; tests only need it to work.
;;
;; :verify-server names one of the `vm-imap-test-servers' above, whose account
;; receives that mail; the test waits for it there and then deletes it.
;;
;; :to and :verify-server have to be two ends of the same mailbox.  The servers
;; above are usually test accounts on a local dovecot, and a test account
;; receives nothing that is sent to your address -- point :verify-server at one
;; of those and every test sends its mail, waits :wait seconds and fails.  Give
;; the account that actually receives :to, which may mean adding a server entry
;; for your own IMAP account.
;;
;; :wait is how long delivery may take, and it wants to be generous.  Measured
;; over 68 sends to one real address with an mbsync mirror: 60 to 110 seconds
;; usually, a tail reaching 150, and three that had not arrived at 180.  A
;; deadline near the middle of that makes the send pass fail for the mail
;; system rather than for VM, which teaches whoever reads the summary to
;; ignore it.  Ten minutes costs nothing when the mail is on time, since the
;; test stops as soon as it arrives.
;;
;; A mailbox that is a mirror -- mbsync, offlineimap -- needs however long the
;; mirror takes on top of delivery itself.

